{% section 'header' %}

<div class="page-contact">
  <div class="container page-contact__container">
    <div class="page-contact__header">
      <h1 class="page-contact__title">{{ page.title }}</h1>
      <p class="page-contact__subtitle">We'd love to hear from you. Drop us a message anytime!</p>
    </div>

    <div class="page-contact__grid">
      <!-- Contact Form -->
      <div class="page-contact__form-wrapper">
        <form method="POST" action="/contact" class="page-contact__form" accept-charset="UTF-8">
          <input type="hidden" name="form_type" value="contact">
          <input type="hidden" name="utf8" value="✓">

          <div class="form-group">
            <label for="ContactFormName" class="form-label">Name</label>
            <input
              type="text"
              id="ContactFormName"
              class="form-input"
              name="contact[name]"
              placeholder="Your full name"
              required
              autocomplete="name"
            >
          </div>

          <div class="form-group">
            <label for="ContactFormEmail" class="form-label">Email</label>
            <input
              type="email"
              id="ContactFormEmail"
              class="form-input"
              name="contact[email]"
              placeholder="your@email.com"
              required
              autocomplete="email"
            >
          </div>

          <div class="form-group">
            <label for="ContactFormPhone" class="form-label">Phone</label>
            <input
              type="tel"
              id="ContactFormPhone"
              class="form-input"
              name="contact[body]"
              placeholder="+92 300 0000000"
              autocomplete="tel"
            >
          </div>

          <div class="form-group">
            <label for="ContactFormMessage" class="form-label">Message</label>
            <textarea
              id="ContactFormMessage"
              class="form-input form-input--textarea"
              name="contact[body]"
              placeholder="Tell us more about your inquiry..."
              rows="6"
              required
            ></textarea>
          </div>

          <button type="submit" class="page-contact__submit">Send Message</button>
        </form>
      </div>

      <!-- Contact Info -->
      <div class="page-contact__info">
        <div class="page-contact__info-box">
          <h3 class="page-contact__info-title">Get in Touch</h3>

          <div class="page-contact__info-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
              <path d="m20 6-8 5-8-5" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            </svg>
            <div>
              <div class="page-contact__info-label">Email</div>
              <a href="mailto:info@pakstyle.pk" class="page-contact__info-link">info@pakstyle.pk</a>
            </div>
          </div>

          <div class="page-contact__info-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            </svg>
            <div>
              <div class="page-contact__info-label">Phone</div>
              <a href="tel:+923000000000" class="page-contact__info-link">+92 300 0000000</a>
            </div>
          </div>

          <div class="page-contact__info-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
              <circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2"/>
            </svg>
            <div>
              <div class="page-contact__info-label">Location</div>
              <div class="page-contact__info-text">Abbottabad, Pakistan</div>
            </div>
          </div>
        </div>

        <div class="page-contact__hours">
          <h4 class="page-contact__hours-title">Business Hours</h4>
          <p class="page-contact__hours-text">Monday - Friday: 9:00 AM - 6:00 PM</p>
          <p class="page-contact__hours-text">Saturday: 10:00 AM - 4:00 PM</p>
          <p class="page-contact__hours-text">Sunday: Closed</p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .page-contact {
    padding: 60px 0;
    background: #FFFFFF;
  }

  .page-contact__container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .page-contact__header {
    text-align: center;
    margin-bottom: 48px;
  }

  .page-contact__title {
    font-size: 2.5rem;
    font-weight: 800;
    color: #0F172A;
    margin: 0 0 12px;
    letter-spacing: -0.02em;
  }

  .page-contact__subtitle {
    font-size: 1.125rem;
    color: #6B7280;
    margin: 0;
  }

  .page-contact__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }

  @media (max-width: 767px) {
    .page-contact__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  .page-contact__form-wrapper {
    background: #F9FAFB;
    padding: 32px;
    border-radius: 12px;
    border: 1px solid #E5E7EB;
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-label {
    display: block;
    font-size: 0.95rem;
    font-weight: 600;
    color: #0F172A;
    margin-bottom: 8px;
  }

  .form-input {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    font-size: 1rem;
    font-family: inherit;
    background: #FFFFFF;
    color: #0F172A;
    transition: border-color 0.2s;
  }

  .form-input:focus {
    outline: none;
    border-color: #F97316;
    box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.1);
  }

  .form-input--textarea {
    resize: vertical;
    min-height: 120px;
  }

  .page-contact__submit {
    width: 100%;
    padding: 14px 24px;
    background: #F97316;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }

  .page-contact__submit:hover {
    background: #EA580C;
  }

  .page-contact__submit:active {
    transform: scale(0.98);
  }

  .page-contact__info-box {
    background: #0F172A;
    color: #FFFFFF;
    padding: 32px;
    border-radius: 12px;
  }

  .page-contact__info-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 28px;
    color: #FFFFFF;
  }

  .page-contact__info-item {
    display: flex;
    gap: 16px;
    margin-bottom: 24px;
    align-items: flex-start;
  }

  .page-contact__info-item svg {
    flex-shrink: 0;
    color: #F97316;
    margin-top: 2px;
  }

  .page-contact__info-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: #D1D5DB;
    margin-bottom: 4px;
  }

  .page-contact__info-link {
    font-size: 1rem;
    color: #FFFFFF;
    text-decoration: none;
    transition: color 0.2s;
  }

  .page-contact__info-link:hover {
    color: #F97316;
  }

  .page-contact__info-text {
    font-size: 1rem;
    color: #FFFFFF;
  }

  .page-contact__hours {
    background: rgba(249, 115, 22, 0.1);
    padding: 24px;
    border-radius: 8px;
    border-left: 4px solid #F97316;
  }

  .page-contact__hours-title {
    font-size: 1rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 12px;
  }

  .page-contact__hours-text {
    font-size: 0.95rem;
    color: #E5E7EB;
    margin: 6px 0;
  }
</style>

{% section 'footer' %}
