{%- liquid
  assign per_page = section.settings.products_per_page | plus: 0
  assign show_banner = section.settings.enable_banner
  assign show_sidebar = section.settings.enable_sidebar_filters
  assign default_sort = section.settings.default_sort
  assign filter_colors = 'Black,White,Navy,Grey,Brown,Olive,Burgundy' | split: ','
  assign filter_sizes = 'XS,S,M,L,XL,XXL' | split: ','
-%}

{%- paginate collection.products by 250 -%}
<section
  id="shopify-section-{{ section.id }}"
  class="ps-collection"
  data-ps-collection
  data-section-id="{{ section.id }}"
  data-per-page="{{ per_page }}"
  data-infinite-scroll="{{ section.settings.infinite_scroll }}"
  data-default-sort="{{ default_sort }}"
  data-total="{{ collection.products_count }}"
>
  <div class="container ps-collection__breadcrumb-wrap">
    <nav class="ps-collection__breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{{ collection.title }}</span>
    </nav>
  </div>

  {%- if show_banner -%}
    <div class="ps-collection__banner">
      {%- if collection.image -%}
        {{ collection.image | image_url: width: 1600 | image_tag: class: 'ps-collection__banner-img', loading: 'eager', sizes: '100vw', alt: collection.title }}
      {%- else -%}
        <div class="ps-collection__banner-placeholder"></div>
      {%- endif -%}
      <div class="ps-collection__banner-overlay"></div>
      <h1 class="ps-collection__banner-title">{{ collection.title }}</h1>
    </div>
  {%- else -%}
    <div class="container ps-collection__title-only">
      <h1 class="ps-collection__heading">{{ collection.title }}</h1>
    </div>
  {%- endif -%}

  <div class="container ps-collection__header">
    {%- if collection.description != blank -%}
      <div class="ps-collection__description rte">{{ collection.description }}</div>
    {%- endif -%}
    <p class="ps-collection__count" data-ps-count-display>
      {{ 'collections.showing_count' | t: shown: 0, total: collection.products_count }}
    </p>
    <div class="ps-collection__active-tags" data-ps-active-tags hidden></div>
  </div>

  <div class="container ps-collection__layout">
    {%- if show_sidebar -%}
      <aside class="ps-collection__sidebar" data-ps-sidebar aria-label="{{ 'collections.filter_by' | t }}">
        <div class="ps-collection__sidebar-inner">
          <div class="ps-collection__sidebar-head">
            <h2 class="ps-collection__sidebar-title">{{ 'collections.filter_by' | t }}</h2>
            <button type="button" class="ps-collection__clear-all" data-ps-clear-all hidden>{{ 'collections.clear_all' | t }}</button>
          </div>

          <div class="ps-collection__filter-group">
            <h3 class="ps-collection__filter-label">{{ 'collections.availability' | t }}</h3>
            <label class="ps-collection__check"><input type="checkbox" data-ps-filter="availability" value="in_stock"> {{ 'collections.in_stock' | t }}</label>
            <label class="ps-collection__check"><input type="checkbox" data-ps-filter="availability" value="out_of_stock"> {{ 'collections.out_of_stock' | t }}</label>
          </div>

          <div class="ps-collection__filter-group">
            <h3 class="ps-collection__filter-label">{{ 'collections.price_range' | t }}</h3>
            <div class="ps-collection__price-inputs">
              <input type="number" class="ps-collection__price-input" data-ps-price-min placeholder="Min" min="0" max="10000">
              <span>—</span>
              <input type="number" class="ps-collection__price-input" data-ps-price-max placeholder="Max" min="0" max="10000">
            </div>
            <input type="range" class="ps-collection__range" data-ps-price-range min="0" max="10000" value="10000" step="100">
            <p class="ps-collection__range-label" data-ps-range-label>PKR 0 — PKR 10,000</p>
            <button type="button" class="btn btn-secondary ps-collection__apply-price" data-ps-apply-price>{{ 'collections.apply' | t }}</button>
          </div>

          <div class="ps-collection__filter-group">
            <h3 class="ps-collection__filter-label">{{ 'collections.size' | t }}</h3>
            <div class="ps-collection__size-btns" data-ps-filter-sizes>
              {%- for size in filter_sizes -%}
                <button type="button" class="ps-collection__size-btn" data-ps-filter="size" data-value="{{ size }}">{{ size }}</button>
              {%- endfor -%}
            </div>
          </div>

          <div class="ps-collection__filter-group">
            <h3 class="ps-collection__filter-label">{{ 'collections.color' | t }}</h3>
            <div class="ps-collection__color-swatches" data-ps-filter-colors>
              {%- assign color_map = 'Black:#000000|White:#ffffff|Navy:#1e3a5f|Grey:#6b7280|Brown:#78350f|Olive:#556b2f|Burgundy:#800020' | split: '|' -%}
              {%- for color_pair in color_map -%}
                {%- assign parts = color_pair | split: ':' -%}
                <button type="button" class="ps-collection__color-swatch" data-ps-filter="color" data-value="{{ parts[0] }}" style="--swatch-bg: {{ parts[1] }}" title="{{ parts[0] }}" aria-label="{{ parts[0] }}">
                  <span class="ps-collection__color-check" aria-hidden="true">✓</span>
                </button>
              {%- endfor -%}
            </div>
          </div>

          <div class="ps-collection__filter-group ps-collection__filter-group--sort-desktop">
            <h3 class="ps-collection__filter-label">{{ 'collections.sort_by' | t }}</h3>
            <select class="ps-collection__sort-select" data-ps-sort-sidebar>
              <option value="featured">{{ 'collections.sort_featured' | t }}</option>
              <option value="price-asc">{{ 'collections.sort_price_asc' | t }}</option>
              <option value="price-desc">{{ 'collections.sort_price_desc' | t }}</option>
              <option value="newest">{{ 'collections.sort_newest' | t }}</option>
              <option value="best-selling">{{ 'collections.sort_best_selling' | t }}</option>
              <option value="top-rated">{{ 'collections.sort_top_rated' | t }}</option>
            </select>
          </div>
        </div>
      </aside>
    {%- endif -%}

    <div class="ps-collection__main">
      <div class="ps-collection__toolbar">
        <p class="ps-collection__toolbar-count" data-ps-toolbar-count>{{ 'collections.showing_count' | t: shown: 0, total: collection.products_count }}</p>
        <div class="ps-collection__toolbar-actions">
          <select class="ps-collection__sort-select ps-collection__sort-select--toolbar" data-ps-sort-toolbar aria-label="{{ 'collections.sort_by' | t }}">
            <option value="featured">{{ 'collections.sort_featured' | t }}</option>
            <option value="price-asc">{{ 'collections.sort_price_asc' | t }}</option>
            <option value="price-desc">{{ 'collections.sort_price_desc' | t }}</option>
            <option value="newest">{{ 'collections.sort_newest' | t }}</option>
            <option value="best-selling">{{ 'collections.sort_best_selling' | t }}</option>
            <option value="top-rated">{{ 'collections.sort_top_rated' | t }}</option>
          </select>
          <div class="ps-collection__view-toggle" role="group" aria-label="View mode">
            <button type="button" class="ps-collection__view-btn is-active" data-ps-view="grid" aria-label="Grid view">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="8" height="8" stroke="currentColor" stroke-width="2"/><rect x="13" y="3" width="8" height="8" stroke="currentColor" stroke-width="2"/><rect x="3" y="13" width="8" height="8" stroke="currentColor" stroke-width="2"/><rect x="13" y="13" width="8" height="8" stroke="currentColor" stroke-width="2"/></svg>
            </button>
            <button type="button" class="ps-collection__view-btn" data-ps-view="list" aria-label="List view">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </button>
          </div>
        </div>
      </div>

      <div class="ps-collection__grid is-grid" data-ps-product-grid>
        {%- for product in collection.products -%}
          {%- liquid
            assign size_values = ''
            assign color_values = ''
            for option in product.options_with_values
              assign opt_name = option.name | downcase
              if opt_name == 'size'
                assign size_values = option.values | join: '|'
              elsif opt_name == 'color' or opt_name == 'colour'
                assign color_values = option.values | join: '|'
              endif
            endfor
            assign product_price = product.price
            assign product_compare = product.compare_at_price
          -%}
          <div
            class="ps-collection__item"
            data-ps-product-item
            data-id="{{ product.id }}"
            data-available="{{ product.available }}"
            data-price="{{ product_price }}"
            data-sizes="{{ size_values | downcase }}"
            data-colors="{{ color_values | downcase }}"
            data-created="{{ product.created_at | date: '%s' }}"
            data-index="{{ forloop.index0 }}"
            data-title="{{ product.title | escape }}"
          >
            <div class="ps-collection__card-grid">{% render 'product-card', card_product: product, list_view: false %}</div>
            <div class="ps-collection__card-list" hidden>{% render 'product-card', card_product: product, list_view: true %}</div>
          </div>
        {%- endfor -%}
      </div>

      <div class="ps-collection__empty" data-ps-empty hidden>
        <div class="ps-collection__empty-icon" aria-hidden="true">
          <svg width="80" height="80" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.5"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M8 11h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </div>
        <h2 class="ps-collection__empty-title">{{ 'collections.no_products' | t }}</h2>
        <p class="ps-collection__empty-text">{{ 'collections.empty_filter_hint' | t }}</p>
        <button type="button" class="btn btn-primary" data-ps-clear-all-empty>{{ 'collections.clear_filters' | t }}</button>
        <div class="ps-collection__suggested">
          <h3 class="ps-collection__suggested-title">{{ 'collections.suggested' | t }}</h3>
          <div class="ps-collection__suggested-grid">
            {%- for product in collection.products limit: 4 -%}
              {% render 'product-card', card_product: product, list_view: false %}
            {%- endfor -%}
          </div>
        </div>
      </div>

      <div class="ps-collection__pagination" data-ps-pagination>
        <button type="button" class="btn btn-secondary ps-collection__load-more" data-ps-load-more hidden>
          {{ 'collections.load_more' | t }}
        </button>
        <p class="ps-collection__pagination-count" data-ps-pagination-count></p>
      </div>
    </div>
  </div>

  {%- comment -%} Mobile filter bottom sheet {%- endcomment -%}
  {%- if show_sidebar -%}
  <button type="button" class="ps-collection__mobile-filter-btn" data-ps-mobile-filter-open>
    {{ 'collections.filter_sort' | t }}
    <span class="ps-collection__filter-badge" data-ps-filter-badge hidden>0</span>
  </button>
  {%- endif -%}

  {%- if show_sidebar -%}
  <div class="ps-collection__sheet" data-ps-mobile-sheet hidden>
    <div class="ps-collection__sheet-backdrop" data-ps-mobile-sheet-close></div>
    <div class="ps-collection__sheet-panel" role="dialog" aria-modal="true" aria-label="{{ 'collections.filter_sort' | t }}">
      <div class="ps-collection__sheet-header">
        <h2>{{ 'collections.filter_sort' | t }}</h2>
        <button type="button" class="ps-collection__sheet-reset" data-ps-mobile-reset>{{ 'collections.reset' | t }}</button>
        <button type="button" class="ps-collection__sheet-close" data-ps-mobile-sheet-close aria-label="{{ 'general.close' | t }}">&times;</button>
      </div>
      <div class="ps-collection__sheet-body" data-ps-mobile-filters>
        {%- comment -%} Cloned filter content via JS from sidebar {%- endcomment -%}
      </div>
      <div class="ps-collection__sheet-footer">
        <button type="button" class="btn btn-primary ps-collection__sheet-apply" data-ps-mobile-apply>{{ 'collections.apply_filters' | t }}</button>
      </div>
    </div>
  </div>
  {%- endif -%}

  <div class="ps-quick-add-modal" data-ps-quick-add-modal hidden>
    <div class="ps-quick-add-modal__backdrop" data-ps-quick-add-close></div>
    <div class="ps-quick-add-modal__panel" role="dialog" aria-modal="true">
      <div class="ps-quick-add-modal__header">
        <h3 data-ps-quick-add-title></h3>
        <button type="button" data-ps-quick-add-close aria-label="{{ 'general.close' | t }}">&times;</button>
      </div>
      <div data-ps-quick-add-options></div>
      <button type="button" class="btn btn-primary" data-ps-quick-add-submit disabled>{{ 'products.add_to_cart' | t }}</button>
    </div>
  </div>
</section>
{%- endpaginate -%}

<style>
  #shopify-section-{{ section.id }} .ps-collection { padding-bottom: 80px; }
  #shopify-section-{{ section.id }} .ps-collection__breadcrumb-wrap { padding: 16px 16px 0; }
  #shopify-section-{{ section.id }} .ps-collection__breadcrumb { display: flex; flex-wrap: wrap; gap: 6px; font-size: 0.8125rem; color: var(--color-text-light, #6B7280); }
  #shopify-section-{{ section.id }} .ps-collection__breadcrumb a { color: var(--color-text-light, #6B7280); }
  #shopify-section-{{ section.id }} .ps-collection__banner { position: relative; height: 300px; overflow: hidden; }
  #shopify-section-{{ section.id }} .ps-collection__banner-img, #shopify-section-{{ section.id }} .ps-collection__banner-placeholder { width: 100%; height: 100%; object-fit: cover; }
  #shopify-section-{{ section.id }} .ps-collection__banner-placeholder { background: linear-gradient(135deg, #0F172A, #334155); }
  #shopify-section-{{ section.id }} .ps-collection__banner-overlay { position: absolute; inset: 0; background: rgba(15,23,42,0.55); }
  #shopify-section-{{ section.id }} .ps-collection__banner-title { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; margin: 0; font-family: var(--font-heading, 'Poppins', sans-serif); font-size: clamp(2rem, 5vw, 3rem); font-weight: 800; color: #fff; text-align: center; padding: 0 24px; z-index: 1; }
  #shopify-section-{{ section.id }} .ps-collection__title-only { padding: 32px 16px 0; }
  #shopify-section-{{ section.id }} .ps-collection__heading { margin: 0; font-family: var(--font-heading, 'Poppins', sans-serif); font-size: 2rem; font-weight: 800; color: var(--color-primary, #0F172A); }
  #shopify-section-{{ section.id }} .ps-collection__header { padding: 24px 16px; }
  #shopify-section-{{ section.id }} .ps-collection__description { margin-bottom: 12px; font-size: 0.9375rem; line-height: 1.7; color: var(--color-text-light, #6B7280); max-width: 720px; }
  #shopify-section-{{ section.id }} .ps-collection__count { margin: 0; font-size: 0.875rem; color: var(--color-text-light, #6B7280); }
  #shopify-section-{{ section.id }} .ps-collection__active-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; align-items: center; }
  #shopify-section-{{ section.id }} .ps-collection__active-tags[hidden] { display: none; }
  #shopify-section-{{ section.id }} .ps-collection__tag { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; background: #f3f4f6; border-radius: 999px; font-size: 0.8125rem; font-weight: 600; color: var(--color-primary, #0F172A); }
  #shopify-section-{{ section.id }} .ps-collection__tag-remove { width: 18px; height: 18px; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-size: 0.875rem; line-height: 1; }
  #shopify-section-{{ section.id }} .ps-collection__layout { display: grid; grid-template-columns: 1fr; gap: 32px; padding: 0 16px; }
  #shopify-section-{{ section.id }} .ps-collection__sidebar { display: none; }
  #shopify-section-{{ section.id }} .ps-collection__sidebar-inner { background: #fff; border: 1px solid var(--color-border, #E5E7EB); border-radius: 12px; padding: 24px; }
  #shopify-section-{{ section.id }} .ps-collection__sidebar-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
  #shopify-section-{{ section.id }} .ps-collection__sidebar-title { margin: 0; font-family: var(--font-heading, 'Poppins', sans-serif); font-size: 1.125rem; font-weight: 700; }
  #shopify-section-{{ section.id }} .ps-collection__clear-all { font-size: 0.8125rem; font-weight: 600; color: var(--color-accent, #F97316); }
  #shopify-section-{{ section.id }} .ps-collection__clear-all[hidden] { display: none; }
  #shopify-section-{{ section.id }} .ps-collection__filter-group { margin-bottom: 24px; padding-bottom: 24px; border-bottom: 1px solid var(--color-border, #E5E7EB); }
  #shopify-section-{{ section.id }} .ps-collection__filter-label { margin: 0 0 12px; font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
  #shopify-section-{{ section.id }} .ps-collection__check { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; font-size: 0.875rem; cursor: pointer; }
  #shopify-section-{{ section.id }} .ps-collection__price-inputs { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
  #shopify-section-{{ section.id }} .ps-collection__price-input { flex: 1; padding: 8px 12px; border: 1px solid var(--color-border, #E5E7EB); border-radius: 6px; font-size: 0.875rem; }
  #shopify-section-{{ section.id }} .ps-collection__range { width: 100%; margin-bottom: 8px; accent-color: var(--color-accent, #F97316); }
  #shopify-section-{{ section.id }} .ps-collection__range-label { margin: 0 0 12px; font-size: 0.8125rem; color: var(--color-text-light, #6B7280); }
  #shopify-section-{{ section.id }} .ps-collection__apply-price { width: 100%; }
  #shopify-section-{{ section.id }} .ps-collection__size-btns { display: flex; flex-wrap: wrap; gap: 8px; }
  #shopify-section-{{ section.id }} .ps-collection__size-btn { min-width: 44px; padding: 10px 14px; border: 2px solid var(--color-border, #E5E7EB); border-radius: 8px; font-size: 0.8125rem; font-weight: 600; transition: all 0.2s; }
  #shopify-section-{{ section.id }} .ps-collection__size-btn.is-selected { border-color: var(--color-accent, #F97316); background: var(--color-accent, #F97316); color: #fff; }
  #shopify-section-{{ section.id }} .ps-collection__color-swatches { display: flex; flex-wrap: wrap; gap: 10px; }
  #shopify-section-{{ section.id }} .ps-collection__color-swatch { position: relative; width: 36px; height: 36px; border-radius: 50%; background: var(--swatch-bg); border: 2px solid rgba(0,0,0,0.12); }
  #shopify-section-{{ section.id }} .ps-collection__color-swatch.is-selected { box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--color-accent, #F97316); }
  #shopify-section-{{ section.id }} .ps-collection__color-check { position: absolute; inset: 0; display: none; align-items: center; justify-content: center; color: #fff; font-size: 0.875rem; font-weight: 700; text-shadow: 0 1px 2px rgba(0,0,0,0.5); }
  #shopify-section-{{ section.id }} .ps-collection__color-swatch.is-selected .ps-collection__color-check { display: flex; }
  #shopify-section-{{ section.id }} .ps-collection__sort-select { width: 100%; padding: 10px 12px; border: 1px solid var(--color-border, #E5E7EB); border-radius: 8px; font-size: 0.875rem; background: #fff; }
  #shopify-section-{{ section.id }} .ps-collection__toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 24px; }
  #shopify-section-{{ section.id }} .ps-collection__toolbar-count { margin: 0; font-size: 0.875rem; color: var(--color-text-light, #6B7280); }
  #shopify-section-{{ section.id }} .ps-collection__toolbar-actions { display: flex; align-items: center; gap: 12px; }
  #shopify-section-{{ section.id }} .ps-collection__sort-select--toolbar { width: auto; min-width: 180px; }
  #shopify-section-{{ section.id }} .ps-collection__view-toggle { display: flex; border: 1px solid var(--color-border, #E5E7EB); border-radius: 8px; overflow: hidden; }
  #shopify-section-{{ section.id }} .ps-collection__view-btn { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; }
  #shopify-section-{{ section.id }} .ps-collection__view-btn.is-active { background: var(--color-primary, #0F172A); color: #fff; }
  #shopify-section-{{ section.id }} .ps-collection__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  #shopify-section-{{ section.id }} .ps-collection__grid.is-list { grid-template-columns: 1fr; }
  #shopify-section-{{ section.id }} .ps-collection__item[hidden] { display: none !important; }
  #shopify-section-{{ section.id }} .ps-collection__grid.is-list .ps-collection__card-grid { display: none; }
  #shopify-section-{{ section.id }} .ps-collection__grid.is-list .ps-collection__card-list { display: block !important; }
  #shopify-section-{{ section.id }} .ps-product-card--list { display: grid; grid-template-columns: 140px 1fr; gap: 20px; padding: 16px; border: 1px solid var(--color-border, #E5E7EB); border-radius: 12px; }
  #shopify-section-{{ section.id }} .ps-product-card__excerpt { margin: 8px 0; font-size: 0.875rem; color: var(--color-text-light, #6B7280); line-height: 1.5; }
  #shopify-section-{{ section.id }} .ps-product-card__media { position: relative; aspect-ratio: 3/4; overflow: hidden; border-radius: 8px; background: var(--color-border, #E5E7EB); }
  #shopify-section-{{ section.id }} .ps-product-card__img { width: 100%; height: 100%; object-fit: cover; transition: opacity 0.4s, transform 0.4s; }
  #shopify-section-{{ section.id }} .ps-product-card__img--secondary { position: absolute; inset: 0; opacity: 0; }
  #shopify-section-{{ section.id }} .ps-product-card__media--has-secondary:hover .ps-product-card__img--primary { opacity: 0; }
  #shopify-section-{{ section.id }} .ps-product-card__media--has-secondary:hover .ps-product-card__img--secondary { opacity: 1; }
  #shopify-section-{{ section.id }} .ps-product-card__badges { position: absolute; top: 8px; left: 8px; z-index: 2; }
  #shopify-section-{{ section.id }} .ps-product-card__wishlist { position: absolute; top: 8px; right: 8px; z-index: 2; width: 36px; height: 36px; background: rgba(255,255,255,0.9); border-radius: 50%; display: flex; align-items: center; justify-content: center; }
  #shopify-section-{{ section.id }} .ps-product-card__wishlist.is-active svg { fill: #ef4444; color: #ef4444; }
  #shopify-section-{{ section.id }} .ps-product-card__quick-add { position: absolute; bottom: 0; left: 0; right: 0; padding: 12px; background: var(--color-primary, #0F172A); color: #fff; font-size: 0.8125rem; font-weight: 600; transform: translateY(100%); transition: transform 0.3s; z-index: 2; }
  #shopify-section-{{ section.id }} .ps-product-card:hover .ps-product-card__quick-add { transform: translateY(0); }
  #shopify-section-{{ section.id }} .ps-product-card__info { padding: 12px 4px 0; }
  #shopify-section-{{ section.id }} .ps-product-card__rating { display: flex; align-items: center; gap: 2px; color: #f59e0b; margin-bottom: 6px; }
  #shopify-section-{{ section.id }} .ps-product-card__title { margin: 0 0 6px; font-size: 0.9375rem; font-weight: 600; }
  #shopify-section-{{ section.id }} .ps-product-card__price-sale { color: var(--color-accent, #F97316); margin-right: 6px; }
  #shopify-section-{{ section.id }} .ps-product-card__placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, #e2e8f0, #cbd5e1); }
  #shopify-section-{{ section.id }} .ps-collection__empty { text-align: center; padding: 48px 16px; }
  #shopify-section-{{ section.id }} .ps-collection__empty[hidden] { display: none; }
  #shopify-section-{{ section.id }} .ps-collection__empty-icon { color: var(--color-text-light, #6B7280); opacity: 0.4; margin-bottom: 16px; }
  #shopify-section-{{ section.id }} .ps-collection__suggested-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-top: 20px; }
  #shopify-section-{{ section.id }} .ps-collection__pagination { text-align: center; padding: 32px 0; }
  #shopify-section-{{ section.id }} .ps-collection__load-more[hidden] { display: none; }
  #shopify-section-{{ section.id }} .ps-collection__mobile-filter-btn { display: flex; align-items: center; justify-content: center; gap: 8px; position: fixed; bottom: 16px; left: 50%; transform: translateX(-50%); z-index: 800; padding: 14px 28px; background: var(--color-primary, #0F172A); color: #fff; font-weight: 700; border-radius: 999px; box-shadow: var(--shadow-lg, 0 10px 25px rgba(0,0,0,0.15)); }
  #shopify-section-{{ section.id }} .ps-collection__filter-badge[hidden] { display: none; }
  #shopify-section-{{ section.id }} .ps-collection__filter-badge { min-width: 20px; height: 20px; padding: 0 6px; background: var(--color-accent, #F97316); border-radius: 999px; font-size: 0.6875rem; font-weight: 700; line-height: 20px; }
  #shopify-section-{{ section.id }} .ps-collection__sheet { position: fixed; inset: 0; z-index: 1200; }
  #shopify-section-{{ section.id }} .ps-collection__sheet[hidden] { display: none; }
  #shopify-section-{{ section.id }} .ps-collection__sheet-backdrop { position: absolute; inset: 0; background: rgba(15,23,42,0.5); }
  #shopify-section-{{ section.id }} .ps-collection__sheet-panel { position: absolute; bottom: 0; left: 0; right: 0; max-height: 90vh; background: #fff; border-radius: 16px 16px 0 0; display: flex; flex-direction: column; }
  #shopify-section-{{ section.id }} .ps-collection__sheet-header { display: flex; align-items: center; gap: 12px; padding: 16px 20px; border-bottom: 1px solid var(--color-border, #E5E7EB); }
  #shopify-section-{{ section.id }} .ps-collection__sheet-header h2 { flex: 1; margin: 0; font-size: 1.125rem; font-weight: 700; }
  #shopify-section-{{ section.id }} .ps-collection__sheet-body { flex: 1; overflow-y: auto; padding: 20px; }
  #shopify-section-{{ section.id }} .ps-collection__sheet-footer { padding: 16px 20px; border-top: 1px solid var(--color-border, #E5E7EB); }
  #shopify-section-{{ section.id }} .ps-collection__sheet-apply { width: 100%; }
  #shopify-section-{{ section.id }} .ps-quick-add-modal { position: fixed; inset: 0; z-index: 1400; display: flex; align-items: flex-end; justify-content: center; }
  #shopify-section-{{ section.id }} .ps-quick-add-modal[hidden] { display: none; }
  #shopify-section-{{ section.id }} .ps-quick-add-modal__backdrop { position: absolute; inset: 0; background: rgba(15,23,42,0.5); }
  #shopify-section-{{ section.id }} .ps-quick-add-modal__panel { position: relative; width: 100%; max-width: 420px; background: #fff; border-radius: 16px 16px 0 0; padding: 24px; }
  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .ps-collection__grid { grid-template-columns: repeat(3, 1fr); gap: 24px; }
    #shopify-section-{{ section.id }} .ps-collection__suggested-grid { grid-template-columns: repeat(4, 1fr); }
  }
  @media screen and (min-width: 1024px) {
    #shopify-section-{{ section.id }} .ps-collection__layout { grid-template-columns: 260px 1fr; }
    #shopify-section-{{ section.id }} .ps-collection__sidebar { display: block; }
    #shopify-section-{{ section.id }} .ps-collection__sidebar-inner { position: sticky; top: 100px; max-height: calc(100vh - 120px); overflow-y: auto; }
    #shopify-section-{{ section.id }} .ps-collection__sort-select--toolbar { display: none; }
    #shopify-section-{{ section.id }} .ps-collection__mobile-filter-btn { display: none; }
    #shopify-section-{{ section.id }} .ps-collection { padding-bottom: 48px; }
  }
  @media screen and (max-width: 1023px) {
    #shopify-section-{{ section.id }} .ps-collection__filter-group--sort-desktop { display: none; }
  }
</style>

<script>
  (function () {
    'use strict';
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    var perPage = parseInt(section.dataset.perPage, 10) || 24;
    var infiniteScroll = section.dataset.infiniteScroll === 'true';
    var defaultSort = section.dataset.defaultSort || 'featured';
    var totalProducts = parseInt(section.dataset.total, 10) || 0;
    var clearAllLabel = {{ 'collections.clear_all' | t | json }};

    var items = Array.from(section.querySelectorAll('[data-ps-product-item]'));
    var grid = section.querySelector('[data-ps-product-grid]');
    var emptyEl = section.querySelector('[data-ps-empty]');
    var loadMoreBtn = section.querySelector('[data-ps-load-more]');
    var paginationCount = section.querySelector('[data-ps-pagination-count]');
    var countDisplay = section.querySelector('[data-ps-count-display]');
    var toolbarCount = section.querySelector('[data-ps-toolbar-count]');
    var activeTagsEl = section.querySelector('[data-ps-active-tags]');
    var filterBadge = section.querySelector('[data-ps-filter-badge]');
    var sidebar = section.querySelector('[data-ps-sidebar]');
    var sortSidebar = section.querySelector('[data-ps-sort-sidebar]');
    var sortToolbar = section.querySelector('[data-ps-sort-toolbar]');
    var mobileSheet = section.querySelector('[data-ps-mobile-sheet]');
    var mobileFilterBody = section.querySelector('[data-ps-mobile-filters]');

    var state = { availability: [], priceMin: 0, priceMax: 1000000, sizes: [], colors: [], sort: defaultSort, view: 'grid', page: 1 };
    var filteredItems = [];

    if (sidebar && mobileFilterBody) {
      var clone = sidebar.querySelector('.ps-collection__sidebar-inner').cloneNode(true);
      var head = clone.querySelector('.ps-collection__sidebar-head');
      var sortDesktop = clone.querySelector('.ps-collection__filter-group--sort-desktop');
      if (head) head.remove();
      if (sortDesktop) sortDesktop.remove();
      mobileFilterBody.appendChild(clone);
    }

    function syncSortSelects(val) {
      if (sortSidebar) sortSidebar.value = val;
      if (sortToolbar) sortToolbar.value = val;
    }

    function readFiltersFromDOM(root) {
      root = root || section;
      state.availability = [];
      root.querySelectorAll('[data-ps-filter="availability"]:checked').forEach(function (cb) { state.availability.push(cb.value); });
      state.sizes = [];
      root.querySelectorAll('[data-ps-filter="size"].is-selected').forEach(function (btn) { state.sizes.push(btn.dataset.value); });
      state.colors = [];
      root.querySelectorAll('[data-ps-filter="color"].is-selected').forEach(function (btn) { state.colors.push(btn.dataset.value.toLowerCase()); });
      var minInput = root.querySelector('[data-ps-price-min]');
      var maxInput = root.querySelector('[data-ps-price-max]');
      state.priceMin = 0;
      state.priceMax = 1000000;
      if (minInput && minInput.value !== '') state.priceMin = parseInt(minInput.value, 10) * 100;
      if (maxInput && maxInput.value !== '') state.priceMax = parseInt(maxInput.value, 10) * 100;
    }

    function syncFilterUI() {
      section.querySelectorAll('[data-ps-filter="availability"]').forEach(function (cb) {
        cb.checked = state.availability.indexOf(cb.value) !== -1;
      });
      section.querySelectorAll('[data-ps-filter="size"]').forEach(function (btn) {
        btn.classList.toggle('is-selected', state.sizes.indexOf(btn.dataset.value) !== -1);
      });
      section.querySelectorAll('[data-ps-filter="color"]').forEach(function (btn) {
        btn.classList.toggle('is-selected', state.colors.indexOf(btn.dataset.value.toLowerCase()) !== -1);
      });
    }

    function countActiveFilters() {
      var n = state.availability.length + state.sizes.length + state.colors.length;
      if (state.priceMin > 0 || state.priceMax < 1000000) n++;
      return n;
    }

    function matchesFilters(item) {
      var available = item.dataset.available === 'true';
      if (state.availability.length) {
        var ok = false;
        if (state.availability.indexOf('in_stock') !== -1 && available) ok = true;
        if (state.availability.indexOf('out_of_stock') !== -1 && !available) ok = true;
        if (!ok) return false;
      }
      var price = parseInt(item.dataset.price, 10);
      if (price < state.priceMin || price > state.priceMax) return false;
      if (state.sizes.length) {
        var sizes = (item.dataset.sizes || '').split('|').filter(Boolean);
        if (!state.sizes.some(function (s) { return sizes.indexOf(s.toLowerCase()) !== -1; })) return false;
      }
      if (state.colors.length) {
        var colors = (item.dataset.colors || '').split('|').filter(Boolean);
        if (!state.colors.some(function (c) {
          return colors.some(function (pc) { return pc.indexOf(c) !== -1 || c.indexOf(pc) !== -1; });
        })) return false;
      }
      return true;
    }

    function sortItems(list) {
      return list.slice().sort(function (a, b) {
        switch (state.sort) {
          case 'price-asc': return parseInt(a.dataset.price, 10) - parseInt(b.dataset.price, 10);
          case 'price-desc': return parseInt(b.dataset.price, 10) - parseInt(a.dataset.price, 10);
          case 'newest': return parseInt(b.dataset.created, 10) - parseInt(a.dataset.created, 10);
          default: return parseInt(a.dataset.index, 10) - parseInt(b.dataset.index, 10);
        }
      });
    }

    function renderActiveTags() {
      if (!activeTagsEl) return;
      var tags = [];
      state.availability.forEach(function (v) {
        tags.push({ type: 'availability', value: v, label: v === 'in_stock' ? 'In Stock' : 'Out of Stock' });
      });
      state.sizes.forEach(function (v) { tags.push({ type: 'size', value: v, label: 'Size: ' + v }); });
      state.colors.forEach(function (v) { tags.push({ type: 'color', value: v, label: 'Color: ' + v.charAt(0).toUpperCase() + v.slice(1) }); });
      if (state.priceMin > 0 || state.priceMax < 1000000) {
        tags.push({ type: 'price', value: '', label: 'Price: PKR ' + (state.priceMin / 100) + '–' + (state.priceMax / 100) });
      }
      if (!tags.length) { activeTagsEl.hidden = true; activeTagsEl.innerHTML = ''; return; }
      activeTagsEl.hidden = false;
      activeTagsEl.innerHTML = tags.map(function (t) {
        return '<span class="ps-collection__tag">' + t.label + '<button type="button" class="ps-collection__tag-remove" data-remove-tag="' + t.type + '" data-tag-value="' + t.value + '">&times;</button></span>';
      }).join('') + (tags.length > 1 ? '<button type="button" class="ps-collection__clear-all" data-ps-clear-all>' + clearAllLabel + '</button>' : '');
      activeTagsEl.querySelectorAll('[data-remove-tag]').forEach(function (btn) {
        btn.addEventListener('click', function () { removeTag(btn.dataset.removeTag, btn.dataset.tagValue); });
      });
      var clearBtn = activeTagsEl.querySelector('[data-ps-clear-all]');
      if (clearBtn) clearBtn.addEventListener('click', clearAllFilters);
    }

    function removeTag(type, value) {
      if (type === 'availability') state.availability = state.availability.filter(function (v) { return v !== value; });
      if (type === 'size') state.sizes = state.sizes.filter(function (v) { return v !== value; });
      if (type === 'color') state.colors = state.colors.filter(function (v) { return v !== value; });
      if (type === 'price') { state.priceMin = 0; state.priceMax = 1000000; }
      syncFilterUI();
      state.page = 1;
      applyFilters();
    }

    function clearAllFilters() {
      state.availability = []; state.sizes = []; state.colors = [];
      state.priceMin = 0; state.priceMax = 1000000;
      section.querySelectorAll('[data-ps-price-min]').forEach(function (el) { el.value = ''; });
      section.querySelectorAll('[data-ps-price-max]').forEach(function (el) { el.value = ''; });
      section.querySelectorAll('[data-ps-price-range]').forEach(function (el) { el.value = 10000; });
      syncFilterUI();
      state.page = 1;
      applyFilters();
    }

    function updateCounts(shown, total) {
      var text = 'Showing ' + shown + ' of ' + total + ' products';
      if (countDisplay) countDisplay.textContent = text;
      if (toolbarCount) toolbarCount.textContent = text;
      if (paginationCount) paginationCount.textContent = text;
    }

    function applyFilters() {
      readFiltersFromDOM(section);
      filteredItems = sortItems(items.filter(matchesFilters));
      var total = filteredItems.length;
      section.querySelectorAll('[data-ps-clear-all]').forEach(function (btn) { btn.hidden = countActiveFilters() === 0; });
      if (filterBadge) { var n = countActiveFilters(); filterBadge.textContent = n; filterBadge.hidden = n === 0; }
      renderActiveTags();
      if (total === 0) {
        grid.hidden = true; emptyEl.hidden = false;
        if (loadMoreBtn) loadMoreBtn.hidden = true;
        updateCounts(0, totalProducts);
        return;
      }
      grid.hidden = false; emptyEl.hidden = true;
      var visibleCount = Math.min(state.page * perPage, total);
      items.forEach(function (item) { item.hidden = true; });
      filteredItems.forEach(function (item, i) {
        item.hidden = i >= visibleCount;
        grid.appendChild(item);
      });
      updateCounts(visibleCount, total);
      if (loadMoreBtn) loadMoreBtn.hidden = infiniteScroll || visibleCount >= total;
    }

    function loadMore() {
      var prev = Math.min(state.page * perPage, filteredItems.length);
      state.page++;
      applyFilters();
      if (filteredItems[prev]) filteredItems[prev].scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    section.addEventListener('click', function (e) {
      var sizeBtn = e.target.closest('[data-ps-filter="size"]');
      var colorBtn = e.target.closest('[data-ps-filter="color"]');
      if (sizeBtn || colorBtn) {
        (sizeBtn || colorBtn).classList.toggle('is-selected');
        state.page = 1;
        applyFilters();
      }
    });

    section.querySelectorAll('[data-ps-filter="availability"]').forEach(function (cb) {
      cb.addEventListener('change', function () { state.page = 1; applyFilters(); });
    });

    section.querySelectorAll('[data-ps-apply-price]').forEach(function (btn) {
      btn.addEventListener('click', function () { state.page = 1; applyFilters(); });
    });

    section.querySelectorAll('[data-ps-price-range]').forEach(function (range) {
      range.addEventListener('input', function () {
        var group = range.closest('.ps-collection__filter-group');
        var label = group && group.querySelector('[data-ps-range-label]');
        var maxInput = group && group.querySelector('[data-ps-price-max]');
        if (maxInput) maxInput.value = range.value;
        if (label) label.textContent = 'PKR 0 — PKR ' + Number(range.value).toLocaleString();
      });
    });

    [sortSidebar, sortToolbar].forEach(function (sel) {
      if (!sel) return;
      sel.value = defaultSort;
      sel.addEventListener('change', function () {
        state.sort = sel.value;
        syncSortSelects(state.sort);
        state.page = 1;
        applyFilters();
      });
    });

    section.querySelectorAll('[data-ps-view]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        state.view = btn.dataset.psView;
        section.querySelectorAll('[data-ps-view]').forEach(function (b) { b.classList.toggle('is-active', b === btn); });
        grid.classList.toggle('is-list', state.view === 'list');
      });
    });

    section.querySelectorAll('[data-ps-clear-all], [data-ps-clear-all-empty]').forEach(function (btn) {
      btn.addEventListener('click', clearAllFilters);
    });
    if (loadMoreBtn) loadMoreBtn.addEventListener('click', loadMore);

    var openMobile = section.querySelector('[data-ps-mobile-filter-open]');
    if (openMobile && mobileSheet) {
      openMobile.addEventListener('click', function () { mobileSheet.hidden = false; document.body.style.overflow = 'hidden'; });
    }
    section.querySelectorAll('[data-ps-mobile-sheet-close]').forEach(function (el) {
      el.addEventListener('click', function () { if (mobileSheet) mobileSheet.hidden = true; document.body.style.overflow = ''; });
    });
    var mobileReset = section.querySelector('[data-ps-mobile-reset]');
    if (mobileReset) mobileReset.addEventListener('click', clearAllFilters);
    var mobileApply = section.querySelector('[data-ps-mobile-apply]');
    if (mobileApply) {
      mobileApply.addEventListener('click', function () {
        if (mobileFilterBody) readFiltersFromDOM(mobileFilterBody);
        syncFilterUI();
        state.page = 1;
        applyFilters();
        mobileSheet.hidden = true;
        document.body.style.overflow = '';
      });
    }

    if (infiniteScroll) {
      var sentinel = document.createElement('div');
      section.querySelector('[data-ps-pagination]').appendChild(sentinel);
      new IntersectionObserver(function (entries) {
        if (entries[0].isIntersecting && filteredItems.length > state.page * perPage) {
          state.page++;
          applyFilters();
        }
      }, { rootMargin: '200px' }).observe(sentinel);
    }

    var modal = section.querySelector('[data-ps-quick-add-modal]');
    var modalTitle = section.querySelector('[data-ps-quick-add-title]');
    var modalOptions = section.querySelector('[data-ps-quick-add-options]');
    var modalSubmit = section.querySelector('[data-ps-quick-add-submit]');
    var selectedVariantId = null;

    section.querySelectorAll('[data-ps-quick-add-close]').forEach(function (el) {
      el.addEventListener('click', function () { if (modal) modal.hidden = true; document.body.style.overflow = ''; });
    });

    section.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-quick-add]');
      if (!btn || !window.PakStyle) return;
      e.preventDefault(); e.stopPropagation();
      var jsonScript = section.querySelector('[data-product-json="' + btn.dataset.productId + '"]');
      if (!jsonScript) return;
      var p = JSON.parse(jsonScript.textContent);
      if (parseInt(btn.dataset.variantCount, 10) <= 1) {
        window.PakStyle.addToCart(btn.dataset.singleVariantId, 1);
        return;
      }
      selectedVariantId = null;
      modalTitle.textContent = p.title;
      modalOptions.innerHTML = '';
      p.variants.forEach(function (v) {
        var opt = document.createElement('button');
        opt.type = 'button';
        opt.className = 'ps-collection__size-btn';
        opt.textContent = v.title;
        opt.disabled = !v.available;
        opt.style.margin = '4px';
        opt.addEventListener('click', function () {
          modalOptions.querySelectorAll('button').forEach(function (o) { o.classList.remove('is-selected'); });
          opt.classList.add('is-selected');
          selectedVariantId = v.id;
          modalSubmit.disabled = false;
        });
        modalOptions.appendChild(opt);
      });
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
    });

    if (modalSubmit) {
      modalSubmit.addEventListener('click', function () {
        if (!selectedVariantId || !window.PakStyle) return;
        window.PakStyle.addToCart(selectedVariantId, 1).then(function () {
          modal.hidden = true;
          document.body.style.overflow = '';
        });
      });
    }

    syncSortSelects(defaultSort);
    applyFilters();
  })();
</script>

{% schema %}
{
  "name": "Collection template",
  "tag": "section",
  "class": "section-collection-template",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_banner",
      "label": "Enable collection banner",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sidebar_filters",
      "label": "Enable sidebar filters",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "infinite_scroll",
      "label": "Enable infinite scroll (disable for Load More button)",
      "default": false
    },
    {
      "type": "select",
      "id": "products_per_page",
      "label": "Products per page",
      "options": [
        { "value": "12", "label": "12" },
        { "value": "24", "label": "24" },
        { "value": "48", "label": "48" }
      ],
      "default": "24"
    },
    {
      "type": "select",
      "id": "default_sort",
      "label": "Default sort order",
      "options": [
        { "value": "featured", "label": "Featured" },
        { "value": "price-asc", "label": "Price: Low to High" },
        { "value": "price-desc", "label": "Price: High to Low" },
        { "value": "newest", "label": "Newest First" },
        { "value": "best-selling", "label": "Best Selling" },
        { "value": "top-rated", "label": "Top Rated" }
      ],
      "default": "featured"
    }
  ],
  "presets": [
    {
      "name": "Collection template"
    }
  ]
}
{% endschema %}
