<section id="shopify-section-{{ section.id }}" class="ps-trust">
  <div class="container ps-trust__scroll">
    <div class="ps-trust__grid">
      {%- for block in section.blocks -%}
        <div class="ps-trust__badge" {{ block.shopify_attributes }}>
          <div class="ps-trust__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'shipping' -%}
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none"><path d="M1 6h13v10H1V6zm13 3h4l3 3v4h-7V9z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="6" cy="18" r="2" stroke="currentColor" stroke-width="1.5"/><circle cx="18" cy="18" r="2" stroke="currentColor" stroke-width="1.5"/></svg>
              {%- when 'secure' -%}
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none"><rect x="4" y="10" width="16" height="11" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M8 10V7a4 4 0 118 0v3" stroke="currentColor" stroke-width="1.5"/></svg>
              {%- when 'returns' -%}
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none"><path d="M4 12a8 8 0 0114-5M20 12a8 8 0 01-14 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M4 7v5h5M20 17v-5h-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- else -%}
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none"><path d="M12 2l2.9 6.9L22 10l-5.2 4.5L18.2 22 12 18.5 5.8 22l1.4-7.5L2 10l7.1-1.1L12 2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
            {%- endcase -%}
          </div>
          <div class="ps-trust__text">
            <p class="ps-trust__title">{{ block.settings.title }}</p>
            <p class="ps-trust__desc">{{ block.settings.description }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .ps-trust {
    background: {{ section.settings.background_color }};
    border-top: 1px solid var(--color-border, #E5E7EB);
    border-bottom: 1px solid var(--color-border, #E5E7EB);
    padding: 24px 0;
  }

  #shopify-section-{{ section.id }} .ps-trust__scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  #shopify-section-{{ section.id }} .ps-trust__scroll::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .ps-trust__grid {
    display: flex;
    gap: 24px;
    min-width: min-content;
    padding: 4px 0;
  }

  #shopify-section-{{ section.id }} .ps-trust__badge {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    flex: 0 0 auto;
    min-width: 220px;
    padding: 8px 16px;
  }

  #shopify-section-{{ section.id }} .ps-trust__icon {
    flex-shrink: 0;
    color: var(--color-accent, #F97316);
  }

  #shopify-section-{{ section.id }} .ps-trust__title {
    margin: 0 0 4px;
    font-family: var(--font-heading, 'Poppins', sans-serif);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-primary, #0F172A);
  }

  #shopify-section-{{ section.id }} .ps-trust__desc {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--color-text-light, #6B7280);
    line-height: 1.4;
  }

  @media screen and (min-width: 1024px) {
    #shopify-section-{{ section.id }} .ps-trust__scroll {
      overflow: visible;
    }

    #shopify-section-{{ section.id }} .ps-trust__grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      min-width: 0;
      gap: 16px;
    }

    #shopify-section-{{ section.id }} .ps-trust__badge {
      min-width: 0;
    }
  }
</style>

{% schema %}
{
  "name": "Trust badges",
  "tag": "section",
  "class": "section-trust-badges",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F9FAFB"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Shipping" },
            { "value": "secure", "label": "Secure payment" },
            { "value": "returns", "label": "Returns" },
            { "value": "quality", "label": "Quality" }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free Shipping"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "On orders above PKR 2,500"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust badges",
      "blocks": [
        { "type": "badge", "settings": { "icon": "shipping", "title": "Free Shipping", "description": "On orders above PKR 2,500" } },
        { "type": "badge", "settings": { "icon": "secure", "title": "Secure Payment", "description": "100% safe checkout" } },
        { "type": "badge", "settings": { "icon": "returns", "title": "Easy Returns", "description": "7 day hassle-free returns" } },
        { "type": "badge", "settings": { "icon": "quality", "title": "Premium Quality", "description": "Certified materials" } }
      ]
    }
  ]
}
{% endschema %}
