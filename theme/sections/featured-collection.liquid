{%- liquid
  assign collection = collections[section.settings.collection]
  assign products_limit = section.settings.products_count
  assign quick_add = section.settings.enable_quick_add
-%}

<section id="shopify-section-{{ section.id }}" class="ps-featured" data-ps-featured>
  <div class="container">
    {%- if section.settings.title != blank -%}
      <div class="ps-featured__header">
        <h2 class="ps-featured__title">{{ section.settings.title }}</h2>
        {%- if collection != blank -%}
          <a href="{{ collection.url }}" class="ps-featured__view-all">{{ 'collections.view_all' | t }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if collection != blank and collection.products_count > 0 -%}
      <div class="ps-featured__grid">
        {%- for product in collection.products limit: products_limit -%}
          {%- liquid
            assign current_variant = product.selected_or_first_available_variant
            assign on_sale = false
            if current_variant.compare_at_price > current_variant.price
              assign on_sale = true
            endif
            assign is_new = false
            if product.tags contains 'new' or product.tags contains 'New'
              assign is_new = true
            endif
            assign second_image = product.images[1]
            assign color_option = nil
            for option in product.options_with_values
              assign opt_name = option.name | downcase
              if opt_name == 'color' or opt_name == 'colour'
                assign color_option = option
                break
              endif
            endfor
          -%}

          <article class="ps-product-card" data-product-id="{{ product.id }}">
            <div class="ps-product-card__media{% if second_image %} ps-product-card__media--has-secondary{% endif %}">
              <a href="{{ product.url }}" class="ps-product-card__link" aria-label="{{ product.title }}">
                {%- if product.featured_image -%}
                  {{
                    product.featured_image
                    | image_url: width: 600
                    | image_tag:
                      class: 'ps-product-card__img ps-product-card__img--primary',
                      loading: 'lazy',
                      widths: '200, 300, 400, 600',
                      sizes: '(max-width: 767px) 50vw, (max-width: 1023px) 33vw, 25vw',
                      alt: product.featured_image.alt | default: product.title
                  }}
                  {%- if second_image -%}
                    {{
                      second_image
                      | image_url: width: 600
                      | image_tag:
                        class: 'ps-product-card__img ps-product-card__img--secondary',
                        loading: 'lazy',
                        widths: '200, 300, 400, 600',
                        sizes: '(max-width: 767px) 50vw, (max-width: 1023px) 33vw, 25vw',
                        alt: second_image.alt | default: product.title
                    }}
                  {%- endif -%}
                {%- else -%}
                  <div class="ps-product-card__placeholder"></div>
                {%- endif -%}
              </a>

              <div class="ps-product-card__badges">
                {%- unless product.available -%}
                  <span class="badge badge-soldout">{{ 'products.sold_out' | t }}</span>
                {%- elsif on_sale -%}
                  <span class="badge badge-sale">Sale</span>
                {%- elsif is_new -%}
                  <span class="badge badge-new">New</span>
                {%- endif -%}
              </div>

              <button
                type="button"
                class="ps-product-card__wishlist"
                data-wishlist-toggle="{{ product.id }}"
                aria-label="{{ 'products.add_to_wishlist' | t }}"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 20.5l-1.05-1.05C5.4 14.4 2 11.36 2 7.5 2 4.42 4.42 2 7.5 2c1.74 0 3.41.81 4.5 2.09C13.09 2.81 14.76 2 16.5 2 19.58 2 22 4.42 22 7.5c0 3.86-3.4 6.9-8.95 11.95L12 20.5z" stroke="currentColor" stroke-width="2"/>
                </svg>
              </button>

              {%- if quick_add and product.available -%}
                <button
                  type="button"
                  class="ps-product-card__quick-add"
                  data-quick-add
                  data-product-id="{{ product.id }}"
                  data-product-handle="{{ product.handle }}"
                  data-variant-count="{{ product.variants.size }}"
                  data-single-variant-id="{{ current_variant.id }}"
                  aria-label="{{ 'products.add_to_cart' | t }}"
                >
                  <span class="ps-product-card__quick-add-text">{{ 'products.quick_add' | t }}</span>
                  <span class="ps-product-card__quick-add-spinner" hidden>
                    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" fill="none" stroke-dasharray="31.4" stroke-linecap="round"><animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="0.8s" repeatCount="indefinite"/></circle></svg>
                  </span>
                  <span class="ps-product-card__quick-add-success" hidden>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12l5 5L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                </button>

                <script type="application/json" data-product-json="{{ product.id }}">
                  {{ product | json }}
                </script>
              {%- endif -%}
            </div>

            <div class="ps-product-card__info">
              <div class="ps-product-card__rating" aria-label="4.5 out of 5 stars">
                {%- for i in (1..5) -%}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="{% if i <= 4 %}currentColor{% else %}none{% endif %}" aria-hidden="true">
                    <path d="M12 2l2.9 6.9L22 10l-5.2 4.5L18.2 22 12 18.5 5.8 22l1.4-7.5L2 10l7.1-1.1L12 2z" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                {%- endfor -%}
                <span class="ps-product-card__rating-text">4.5</span>
              </div>

              <h3 class="ps-product-card__title">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>

              <div class="ps-product-card__price">
                {%- if on_sale -%}
                  <span class="ps-product-card__price-sale">{{ current_variant.price | money }}</span>
                  <s class="ps-product-card__price-compare">{{ current_variant.compare_at_price | money }}</s>
                {%- else -%}
                  <span>{{ current_variant.price | money }}</span>
                {%- endif -%}
              </div>

              {%- if color_option and color_option.values.size > 0 -%}
                <div class="ps-product-card__swatches">
                  {%- for value in color_option.values limit: 5 -%}
                    {%- assign swatch_color = value | handle | replace: '-', '' -%}
                    <span
                      class="ps-product-card__swatch"
                      title="{{ value }}"
                      style="{% if value contains '#' %}background-color: {{ value }};{% else %}background-color: var(--swatch-{{ swatch_color }}, #ccc);{% endif %}"
                    ></span>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="ps-featured__empty">{{ 'collections.no_products' | t }}</p>
    {%- endif -%}
  </div>

  {%- comment -%} Quick add variant modal {%- endcomment -%}
  <div class="ps-quick-add-modal" data-ps-quick-add-modal hidden>
    <div class="ps-quick-add-modal__backdrop" data-ps-quick-add-close></div>
    <div class="ps-quick-add-modal__panel" role="dialog" aria-modal="true" aria-label="{{ 'products.select_size' | t }}">
      <div class="ps-quick-add-modal__header">
        <h3 class="ps-quick-add-modal__title" data-ps-quick-add-title></h3>
        <button type="button" class="ps-quick-add-modal__close" data-ps-quick-add-close aria-label="{{ 'general.close' | t }}">&times;</button>
      </div>
      <div class="ps-quick-add-modal__options" data-ps-quick-add-options></div>
      <button type="button" class="btn btn-primary ps-quick-add-modal__submit" data-ps-quick-add-submit disabled>
        {{ 'products.add_to_cart' | t }}
      </button>
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .ps-featured {
    padding: var(--spacing-lg, 48px) 0;
  }

  #shopify-section-{{ section.id }} .ps-featured__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .ps-featured__title {
    margin: 0;
    font-family: var(--font-heading, 'Poppins', sans-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--color-primary, #0F172A);
  }

  #shopify-section-{{ section.id }} .ps-featured__view-all {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent, #F97316);
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .ps-featured__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .ps-product-card__media {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: var(--border-radius-md, 8px);
    background: var(--color-border, #E5E7EB);
  }

  #shopify-section-{{ section.id }} .ps-product-card__link {
    display: block;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .ps-product-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  #shopify-section-{{ section.id }} .ps-product-card__img--secondary {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  #shopify-section-{{ section.id }} .ps-product-card__media--has-secondary:hover .ps-product-card__img--primary {
    opacity: 0;
  }

  #shopify-section-{{ section.id }} .ps-product-card__media--has-secondary:hover .ps-product-card__img--secondary {
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .ps-product-card__media:not(.ps-product-card__media--has-secondary):hover .ps-product-card__img--primary {
    transform: scale(1.05);
  }

  #shopify-section-{{ section.id }} .ps-product-card:hover .ps-product-card__img--primary {
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .ps-product-card:hover .ps-product-card__img--secondary {
    opacity: 0;
  }

  #shopify-section-{{ section.id }} .ps-product-card__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #e2e8f0, #cbd5e1);
  }

  #shopify-section-{{ section.id }} .ps-product-card__badges {
    position: absolute;
    top: 8px;
    left: 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .ps-product-card__wishlist {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    color: var(--color-text-light, #6B7280);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  #shopify-section-{{ section.id }} .ps-product-card__wishlist:hover,
  #shopify-section-{{ section.id }} .ps-product-card__wishlist.is-active {
    color: #ef4444;
    transform: scale(1.1);
  }

  #shopify-section-{{ section.id }} .ps-product-card__wishlist.is-active svg {
    fill: #ef4444;
  }

  #shopify-section-{{ section.id }} .ps-product-card__quick-add {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 12px;
    background: var(--color-primary, #0F172A);
    color: #fff;
    font-family: var(--font-heading, 'Poppins', sans-serif);
    font-size: 0.8125rem;
    font-weight: 600;
    transform: translateY(100%);
    transition: transform 0.3s ease;
  }

  #shopify-section-{{ section.id }} .ps-product-card:hover .ps-product-card__quick-add {
    transform: translateY(0);
  }

  #shopify-section-{{ section.id }} .ps-product-card__quick-add.is-loading .ps-product-card__quick-add-text,
  #shopify-section-{{ section.id }} .ps-product-card__quick-add.is-success .ps-product-card__quick-add-text {
    display: none;
  }

  #shopify-section-{{ section.id }} .ps-product-card__quick-add.is-loading .ps-product-card__quick-add-spinner,
  #shopify-section-{{ section.id }} .ps-product-card__quick-add.is-success .ps-product-card__quick-add-success {
    display: flex !important;
  }

  #shopify-section-{{ section.id }} .ps-product-card__info {
    padding: 12px 4px 0;
  }

  #shopify-section-{{ section.id }} .ps-product-card__rating {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-bottom: 6px;
    color: #f59e0b;
  }

  #shopify-section-{{ section.id }} .ps-product-card__rating-text {
    margin-left: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-light, #6B7280);
  }

  #shopify-section-{{ section.id }} .ps-product-card__title {
    margin: 0 0 6px;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .ps-product-card__title a {
    color: var(--color-primary, #0F172A);
  }

  #shopify-section-{{ section.id }} .ps-product-card__price {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-primary, #0F172A);
  }

  #shopify-section-{{ section.id }} .ps-product-card__price-sale {
    color: var(--color-accent, #F97316);
    margin-right: 6px;
  }

  #shopify-section-{{ section.id }} .ps-product-card__price-compare {
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--color-text-light, #6B7280);
  }

  #shopify-section-{{ section.id }} .ps-product-card__swatches {
    display: flex;
    gap: 6px;
    margin-top: 8px;
  }

  #shopify-section-{{ section.id }} .ps-product-card__swatch {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.1);
  }

  #shopify-section-{{ section.id }} .ps-featured__empty {
    text-align: center;
    color: var(--color-text-light, #6B7280);
    padding: 48px 0;
  }

  /* Quick add modal */
  #shopify-section-{{ section.id }} .ps-quick-add-modal {
    position: fixed;
    inset: 0;
    z-index: 1400;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .ps-quick-add-modal[hidden] {
    display: none;
  }

  #shopify-section-{{ section.id }} .ps-quick-add-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.5);
  }

  #shopify-section-{{ section.id }} .ps-quick-add-modal__panel {
    position: relative;
    width: 100%;
    max-width: 420px;
    background: #fff;
    border-radius: 16px 16px 0 0;
    padding: 24px;
    animation: psSlideUpModal 0.3s ease;
  }

  @keyframes psSlideUpModal {
    from { transform: translateY(100%); }
    to { transform: translateY(0); }
  }

  #shopify-section-{{ section.id }} .ps-quick-add-modal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  #shopify-section-{{ section.id }} .ps-quick-add-modal__title {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .ps-quick-add-modal__close {
    width: 36px;
    height: 36px;
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .ps-quick-add-modal__options {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  #shopify-section-{{ section.id }} .ps-quick-add-modal__option {
    padding: 10px 16px;
    border: 2px solid var(--color-border, #E5E7EB);
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 600;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  #shopify-section-{{ section.id }} .ps-quick-add-modal__option.is-selected {
    border-color: var(--color-accent, #F97316);
    background: rgba(249, 115, 22, 0.08);
  }

  #shopify-section-{{ section.id }} .ps-quick-add-modal__option:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    text-decoration: line-through;
  }

  #shopify-section-{{ section.id }} .ps-quick-add-modal__submit {
    width: 100%;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .ps-featured__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    #shopify-section-{{ section.id }} .ps-quick-add-modal {
      align-items: center;
    }

    #shopify-section-{{ section.id }} .ps-quick-add-modal__panel {
      border-radius: 16px;
    }
  }

  @media screen and (min-width: 1024px) {
    #shopify-section-{{ section.id }} .ps-featured__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>

<script>
  (function () {
    'use strict';

    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    var modal = section.querySelector('[data-ps-quick-add-modal]');
    var modalTitle = section.querySelector('[data-ps-quick-add-title]');
    var modalOptions = section.querySelector('[data-ps-quick-add-options]');
    var modalSubmit = section.querySelector('[data-ps-quick-add-submit]');
    var activeProduct = null;
    var selectedVariantId = null;

    function setQuickAddState(btn, state) {
      btn.classList.remove('is-loading', 'is-success');
      if (state) btn.classList.add(state);
      if (state === 'is-success') {
        setTimeout(function () { btn.classList.remove('is-success'); }, 2000);
      }
    }

    function openModal(product) {
      activeProduct = product;
      selectedVariantId = null;
      modalTitle.textContent = product.title;
      modalOptions.innerHTML = '';

      product.variants.forEach(function (variant) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'ps-quick-add-modal__option';
        btn.textContent = variant.title;
        btn.disabled = !variant.available;
        btn.dataset.variantId = variant.id;

        btn.addEventListener('click', function () {
          modalOptions.querySelectorAll('.ps-quick-add-modal__option').forEach(function (o) {
            o.classList.remove('is-selected');
          });
          btn.classList.add('is-selected');
          selectedVariantId = variant.id;
          modalSubmit.disabled = false;
        });

        modalOptions.appendChild(btn);
      });

      modal.hidden = false;
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.hidden = true;
      document.body.style.overflow = '';
      activeProduct = null;
      selectedVariantId = null;
    }

    section.querySelectorAll('[data-ps-quick-add-close]').forEach(function (el) {
      el.addEventListener('click', closeModal);
    });

    if (modalSubmit) {
      modalSubmit.addEventListener('click', function () {
        if (!selectedVariantId) return;
        var cardBtn = section.querySelector('[data-product-id="' + activeProduct.id + '"] [data-quick-add]');
        closeModal();
        addToCart(selectedVariantId, cardBtn);
      });
    }

    function addToCart(variantId, btn) {
      if (!window.PakStyle || !window.PakStyle.addToCart) return;

      if (btn) setQuickAddState(btn, 'is-loading');

      window.PakStyle.addToCart(variantId, 1)
        .then(function () {
          if (btn) setQuickAddState(btn, 'is-success');
        })
        .catch(function () {
          if (btn) setQuickAddState(btn, null);
        });
    }

    section.querySelectorAll('[data-quick-add]').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();

        var variantCount = parseInt(btn.dataset.variantCount, 10);
        var productId = btn.dataset.productId;
        var jsonEl = section.querySelector('[data-product-json="' + productId + '"]');

        if (variantCount <= 1) {
          addToCart(btn.dataset.singleVariantId, btn);
          return;
        }

        if (jsonEl) {
          try {
            openModal(JSON.parse(jsonEl.textContent));
          } catch (err) {
            console.error('[PakStyle] Product JSON parse error', err);
          }
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "New Arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "select",
      "id": "products_count",
      "label": "Products to show",
      "options": [
        { "value": "4", "label": "4" },
        { "value": "8", "label": "8" },
        { "value": "12", "label": "12" }
      ],
      "default": "8"
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "label": "Enable quick add to cart",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
