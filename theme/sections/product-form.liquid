<script>
  (function () {
    'use strict';

    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    var WISHLIST_KEY = 'pakstyle_wishlist';
    var RECENT_KEY = 'pakstyle_recently_viewed';
    var LOW_STOCK = 5;
    var SWATCH_COLORS = {
      black: '#000000', white: '#ffffff', navy: '#1e3a5f', 'navy-blue': '#1e3a5f',
      blue: '#2563eb', red: '#dc2626', green: '#16a34a', grey: '#6b7280', gray: '#6b7280',
      beige: '#d4c4a8', brown: '#78350f', olive: '#556b2f', maroon: '#800000', pink: '#ec4899'
    };

    var jsonEl = section.querySelector('[data-ps-product-json]');
    var product = jsonEl ? JSON.parse(jsonEl.textContent) : null;
    if (!product) return;

    function getVariantOptions(variant) {
      return [variant.option1, variant.option2, variant.option3].filter(function (o) { return o; });
    }

    function findVariant(opts) {
      return product.variants.find(function (v) {
        var vOpts = getVariantOptions(v);
        return opts.every(function (o, i) { return vOpts[i] === o; });
      });
    }

    function formatMoney(cents) {
      return window.PakStyle && window.PakStyle.formatMoney ? window.PakStyle.formatMoney(cents) : 'PKR ' + (cents / 100).toFixed(2);
    }

    /* Gallery */
    var slides = section.querySelectorAll('[data-ps-media-slide]');
    var thumbs = section.querySelectorAll('[data-ps-thumb]');
    var counter = section.querySelector('[data-ps-counter]');
    var currentSlide = 0;

    function goToSlide(index) {
      currentSlide = index;
      slides.forEach(function (s, i) { s.classList.toggle('is-active', i === index); });
      thumbs.forEach(function (t, i) { t.classList.toggle('is-active', i === index); });
      if (counter) counter.textContent = (index + 1) + ' / ' + slides.length;
    }

    thumbs.forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        goToSlide(parseInt(thumb.dataset.mediaIndex, 10));
      });
    });

    /* Mobile swipe */
    var track = section.querySelector('[data-ps-media-track]');
    if (track && slides.length > 1) {
      var startX = 0;
      track.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX; }, { passive: true });
      track.addEventListener('touchend', function (e) {
        var diff = startX - e.changedTouches[0].clientX;
        if (Math.abs(diff) > 50) {
          if (diff > 0) goToSlide((currentSlide + 1) % slides.length);
          else goToSlide((currentSlide - 1 + slides.length) % slides.length);
        }
      }, { passive: true });
    }

    /* Color swatches background */
    section.querySelectorAll('[data-swatch-name]').forEach(function (el) {
      var name = el.dataset.swatchName;
      if (SWATCH_COLORS[name]) el.style.backgroundColor = SWATCH_COLORS[name];
    });

    /* Variant selection */
    var variantInput = section.querySelector('[data-ps-variant-input]');
    var priceEl = section.querySelector('[data-ps-price]');
    var compareEl = section.querySelector('[data-ps-compare]');
    var saveBadge = section.querySelector('[data-ps-save-badge]');
    var stockEl = section.querySelector('[data-ps-stock]');
    var selectedOptsEl = section.querySelector('[data-ps-selected-options]');
    var atcBtn = section.querySelector('[data-ps-add-to-cart]');
    var buyNowBtn = section.querySelector('[data-ps-buy-now]');
    var stickyPrice = section.querySelector('[data-ps-sticky-price]');
    var stickyAtc = section.querySelector('[data-ps-sticky-atc]');
    var atcText = section.querySelector('[data-ps-atc-text]');

    function getSelectedOptions() {
      var opts = [];
      section.querySelectorAll('[data-option-index]').forEach(function (group) {
        var selected = group.querySelector('.is-selected');
        opts.push(selected ? selected.dataset.optionValue : '');
      });
      if (!opts.length && product.variants.length === 1) {
        return getVariantOptions(product.variants[0]);
      }
      return opts;
    }

    function updateAvailabilityUI() {
      var selected = getSelectedOptions();
      section.querySelectorAll('.ps-pdp__size-btn').forEach(function (btn) {
        var group = btn.closest('[data-option-index]');
        if (!group) return;
        var idx = parseInt(group.dataset.optionIndex, 10);
        var testOpts = selected.slice();
        testOpts[idx] = btn.dataset.optionValue;
        var match = findVariant(testOpts);
        btn.classList.toggle('is-unavailable', !match || !match.available);
      });
    }

    function updateVariantUI(variant) {
      if (!variant) return;
      if (variantInput) variantInput.value = variant.id;

      if (priceEl) {
        priceEl.textContent = formatMoney(variant.price);
        priceEl.classList.toggle('ps-pdp__price--sale', variant.compare_at_price > variant.price);
      }
      if (compareEl) {
        if (variant.compare_at_price > variant.price) {
          compareEl.textContent = formatMoney(variant.compare_at_price);
          compareEl.hidden = false;
          if (saveBadge) {
            var pct = Math.round((variant.compare_at_price - variant.price) * 100 / variant.compare_at_price);
            saveBadge.textContent = 'SAVE ' + pct + '%';
            saveBadge.hidden = false;
          }
        } else {
          compareEl.hidden = true;
          if (saveBadge) saveBadge.hidden = true;
        }
      }
      if (stickyPrice) stickyPrice.textContent = formatMoney(variant.price);

      if (stockEl) {
        var dot = stockEl.querySelector('.ps-pdp__stock-dot');
        var text = stockEl.querySelector('[data-ps-stock-text]');
        dot.className = 'ps-pdp__stock-dot';
        if (!variant.available) {
          dot.classList.add('ps-pdp__stock-dot--red');
          text.textContent = 'Out of Stock';
          if (atcBtn) atcBtn.disabled = true;
          if (buyNowBtn) buyNowBtn.disabled = true;
          if (stickyAtc) stickyAtc.disabled = true;
          if (atcText) atcText.textContent = 'Sold Out';
        } else if (variant.inventory_management && variant.inventory_quantity > 0 && variant.inventory_quantity <= LOW_STOCK) {
          dot.classList.add('ps-pdp__stock-dot--yellow');
          text.textContent = 'Only ' + variant.inventory_quantity + ' left!';
          if (atcBtn) atcBtn.disabled = false;
          if (buyNowBtn) buyNowBtn.disabled = false;
          if (stickyAtc) stickyAtc.disabled = false;
          if (atcText) atcText.textContent = 'Add to Cart';
        } else {
          dot.classList.add('ps-pdp__stock-dot--green');
          text.textContent = 'In Stock — Ships within 24 hours';
          if (atcBtn) atcBtn.disabled = false;
          if (buyNowBtn) buyNowBtn.disabled = false;
          if (stickyAtc) stickyAtc.disabled = false;
          if (atcText) atcText.textContent = 'Add to Cart';
        }
      }

      var opts = getVariantOptions(variant);
      if (selectedOptsEl && product.options) {
        selectedOptsEl.textContent = product.options.map(function (name, i) {
          return name + ': ' + (opts[i] || '—');
        }).join(' | ');
      }

      if (variant.featured_image) {
        var imgIndex = product.media ? product.media.findIndex(function (m) { return m.id === variant.featured_image.id; }) : -1;
        if (imgIndex >= 0) goToSlide(imgIndex);
      }

      var url = new URL(window.location.href);
      url.searchParams.set('variant', variant.id);
      window.history.replaceState({}, '', url.toString());
    }

    section.querySelectorAll('[data-option-value]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var group = btn.closest('[data-option-index]');
        group.querySelectorAll('[data-option-value]').forEach(function (b) { b.classList.remove('is-selected'); });
        btn.classList.add('is-selected');
        var variant = findVariant(getSelectedOptions());
        if (variant) updateVariantUI(variant);
        updateAvailabilityUI();
      });
    });

    updateAvailabilityUI();
    var initVariant = findVariant(getSelectedOptions()) || product.variants[0];
    if (initVariant) updateVariantUI(initVariant);

    /* Quantity */
    var qtyInput = section.querySelector('[data-ps-qty-input]');
    section.querySelector('[data-ps-qty-minus]') && section.querySelector('[data-ps-qty-minus]').addEventListener('click', function () {
      qtyInput.value = Math.max(1, parseInt(qtyInput.value, 10) - 1);
    });
    section.querySelector('[data-ps-qty-plus]') && section.querySelector('[data-ps-qty-plus]').addEventListener('click', function () {
      qtyInput.value = parseInt(qtyInput.value, 10) + 1;
    });

    /* Add to cart */
    function handleAddToCart(btn, openDrawer) {
      if (!window.PakStyle) return;
      var variantId = variantInput.value;
      var qty = parseInt(qtyInput.value, 10) || 1;
      var mainBtn = section.querySelector('[data-ps-add-to-cart]');
      if (mainBtn) {
        mainBtn.classList.add('is-loading');
        mainBtn.classList.remove('is-success');
      }
      window.PakStyle.addToCart(variantId, qty).then(function () {
        if (mainBtn) {
          mainBtn.classList.remove('is-loading');
          mainBtn.classList.add('is-success');
          setTimeout(function () { mainBtn.classList.remove('is-success'); }, 2500);
        }
        if (openDrawer !== false && window.PakStyle.toggleCartDrawer) {
          window.PakStyle.toggleCartDrawer(true);
        }
      }).catch(function () {
        if (mainBtn) mainBtn.classList.remove('is-loading');
      });
    }

    if (atcBtn) atcBtn.addEventListener('click', function () { handleAddToCart(atcBtn, true); });
    if (stickyAtc) stickyAtc.addEventListener('click', function () { handleAddToCart(stickyAtc, true); });

    if (buyNowBtn) {
      buyNowBtn.addEventListener('click', function () {
        if (!window.PakStyle) return;
        var variantId = variantInput.value;
        var qty = parseInt(qtyInput.value, 10) || 1;
        window.PakStyle.addToCart(variantId, qty).then(function () {
          window.location.href = '/checkout';
        });
      });
    }

    /* Wishlist */
    var wishlistBtn = section.querySelector('[data-ps-wishlist-btn]');
    function getWishlist() { try { return JSON.parse(localStorage.getItem(WISHLIST_KEY) || '[]'); } catch (e) { return []; } }
    function updateWishlistBtn() {
      if (!wishlistBtn) return;
      var active = getWishlist().indexOf(String(product.id)) !== -1;
      wishlistBtn.classList.toggle('is-active', active);
      var icon = wishlistBtn.querySelector('[data-ps-wishlist-icon]');
      if (icon) icon.textContent = active ? '♥' : '♡';
    }
    if (wishlistBtn) {
      updateWishlistBtn();
      wishlistBtn.addEventListener('click', function () {
        var list = getWishlist();
        var id = String(product.id);
        var idx = list.indexOf(id);
        if (idx === -1) list.push(id); else list.splice(idx, 1);
        localStorage.setItem(WISHLIST_KEY, JSON.stringify(list));
        document.dispatchEvent(new CustomEvent('pakstyle:wishlist:updated'));
        updateWishlistBtn();
      });
    }

    /* Copy link */
    section.querySelector('[data-ps-copy-link]') && section.querySelector('[data-ps-copy-link]').addEventListener('click', function () {
      navigator.clipboard.writeText(window.location.href).then(function () {
        var btn = section.querySelector('[data-ps-copy-link]');
        var orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(function () { btn.textContent = orig; }, 2000);
      });
    });

    /* Tabs */
    section.querySelectorAll('[data-ps-tab]').forEach(function (tab) {
      tab.addEventListener('click', function () {
        var id = tab.dataset.psTab;
        section.querySelectorAll('[data-ps-tab]').forEach(function (t) {
          t.classList.toggle('is-active', t === tab);
          t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
        });
        section.querySelectorAll('[data-ps-tab-panel]').forEach(function (panel) {
          var show = panel.dataset.psTabPanel === id;
          panel.classList.toggle('is-active', show);
          panel.hidden = !show;
        });
      });
    });

    /* Sticky bar */
    var stickyBar = section.querySelector('[data-ps-sticky-bar]');
    var mainAtcWrap = section.querySelector('[data-ps-main-atc-wrap]');
    if (stickyBar && mainAtcWrap && section.dataset.enableSticky === 'true') {
      stickyBar.hidden = false;
      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function (entries) {
          var visible = entries[0].isIntersecting;
          stickyBar.classList.toggle('is-visible', !visible);
        }, { threshold: 0 });
        observer.observe(mainAtcWrap);
      }
    }

    /* Recently viewed */
    function saveRecentlyViewed() {
      if (section.dataset.enableRecent !== 'true') return;
      try {
        var list = JSON.parse(localStorage.getItem(RECENT_KEY) || '[]');
        var img = product.featured_image || (product.images && product.images[0]);
        var item = {
          id: product.id,
          handle: product.handle,
          title: product.title,
          url: '/products/' + product.handle,
          price: product.price,
          compare_at_price: product.compare_at_price,
          image: img ? (img.src || img) : null,
          available: product.available
        };
        list = list.filter(function (p) { return p.id !== product.id; });
        list.unshift(item);
        list = list.slice(0, 8);
        localStorage.setItem(RECENT_KEY, JSON.stringify(list));
      } catch (e) {}
    }

    function renderRecentlyViewed() {
      if (section.dataset.enableRecent !== 'true') return;
      var recentSection = section.querySelector('[data-ps-recent-section]');
      var grid = section.querySelector('[data-ps-recent-grid]');
      if (!recentSection || !grid) return;

      var list = JSON.parse(localStorage.getItem(RECENT_KEY) || '[]')
        .filter(function (p) { return p.id !== product.id; })
        .slice(0, 4);

      if (!list.length) return;

      recentSection.hidden = false;
      grid.innerHTML = list.map(function (p) {
        var imgUrl = '';
        if (p.image) {
          imgUrl = typeof p.image === 'string' ? p.image : (p.image.src || p.image.url || '');
        }
        var onSale = p.compare_at_price && p.compare_at_price > p.price;
        return '<article class="ps-product-card">' +
          '<div class="ps-product-card__media"><a href="' + p.url + '" class="ps-product-card__link">' +
          (imgUrl ? '<img src="' + imgUrl + '" alt="" class="ps-product-card__img ps-product-card__img--primary" loading="lazy">' : '<div class="ps-product-card__placeholder"></div>') +
          '</a></div><div class="ps-product-card__info">' +
          '<h3 class="ps-product-card__title"><a href="' + p.url + '">' + p.title + '</a></h3>' +
          '<div class="ps-product-card__price">' +
          (onSale ? '<span class="ps-product-card__price-sale">' + formatMoney(p.price) + '</span><s class="ps-product-card__price-compare">' + formatMoney(p.compare_at_price) + '</s>' : '<span>' + formatMoney(p.price) + '</span>') +
          '</div></div></article>';
      }).join('');
    }

    saveRecentlyViewed();
    renderRecentlyViewed();

    /* Quick add for related products */
    var modal = section.querySelector('[data-ps-quick-add-modal]');
    var modalTitle = section.querySelector('[data-ps-quick-add-title]');
    var modalOptions = section.querySelector('[data-ps-quick-add-options]');
    var modalSubmit = section.querySelector('[data-ps-quick-add-submit]');
    var activeProduct = null;
    var selectedVariantId = null;

    section.querySelectorAll('[data-ps-quick-add-close]').forEach(function (el) {
      el.addEventListener('click', function () { modal.hidden = true; document.body.style.overflow = ''; });
    });

    if (modalSubmit) {
      modalSubmit.addEventListener('click', function () {
        if (!selectedVariantId || !window.PakStyle) return;
        window.PakStyle.addToCart(selectedVariantId, 1).then(function () {
          modal.hidden = true;
          document.body.style.overflow = '';
          window.PakStyle.toggleCartDrawer(true);
        });
      });
    }

    section.querySelectorAll('[data-quick-add]').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var productId = btn.dataset.productId;
        var jsonScript = section.querySelector('[data-product-json="' + productId + '"]');
        if (!jsonScript) return;
        var p = JSON.parse(jsonScript.textContent);
        if (parseInt(btn.dataset.variantCount, 10) <= 1) {
          window.PakStyle.addToCart(btn.dataset.singleVariantId, 1).then(function () {
            window.PakStyle.toggleCartDrawer(true);
          });
          return;
        }
        activeProduct = p;
        selectedVariantId = null;
        modalTitle.textContent = p.title;
        modalOptions.innerHTML = '';
        p.variants.forEach(function (v) {
          var opt = document.createElement('button');
          opt.type = 'button';
          opt.className = 'ps-quick-add-modal__option';
          opt.textContent = v.title;
          opt.disabled = !v.available;
          opt.addEventListener('click', function () {
            modalOptions.querySelectorAll('.ps-quick-add-modal__option').forEach(function (o) { o.classList.remove('is-selected'); });
            opt.classList.add('is-selected');
            selectedVariantId = v.id;
            modalSubmit.disabled = false;
          });
          modalOptions.appendChild(opt);
        });
        modal.hidden = false;
        document.body.style.overflow = 'hidden';
      });
    });

    section.querySelectorAll('[data-wishlist-toggle]').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var list = getWishlist();
        var id = String(btn.dataset.wishlistToggle);
        var idx = list.indexOf(id);
        if (idx === -1) list.push(id); else list.splice(idx, 1);
        localStorage.setItem(WISHLIST_KEY, JSON.stringify(list));
        btn.classList.toggle('is-active', list.indexOf(id) !== -1);
        document.dispatchEvent(new CustomEvent('pakstyle:wishlist:updated'));
      });
    });

    section.querySelectorAll('[data-wishlist-toggle]').forEach(function (btn) {
      btn.classList.toggle('is-active', getWishlist().indexOf(String(btn.dataset.wishlistToggle)) !== -1);
    });
  })();
</script>

{% schema %}
{
  "name": "Product form",
  "tag": "section",
  "class": "section-product-form",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky_bar",
      "label": "Enable sticky mobile add to cart bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_recently_viewed",
      "label": "Enable recently viewed products",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_related_products",
      "label": "Enable related products",
      "default": true
    },
    {
      "type": "select",
      "id": "related_products_count",
      "label": "Number of related products",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    }
  ],
  "presets": [
    {
      "name": "Product form"
    }
  ]
}
{% endschema %}
