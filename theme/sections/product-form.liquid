{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign bc_collection = collection | default: product.collections.first
  assign on_sale = false
  assign save_percent = 0
  if current_variant.compare_at_price > current_variant.price
    assign on_sale = true
    assign save_percent = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price
  endif
  assign short_desc = product.description | strip_html | truncate: 150
  assign media_count = product.media.size
  if media_count == 0 and product.featured_image
    assign media_count = 1
  endif
  assign related_limit = section.settings.related_products_count | plus: 0
  assign low_stock_threshold = 5
-%}

<section
  id="shopify-section-{{ section.id }}"
  class="ps-pdp"
  data-ps-pdp
  data-product-id="{{ product.id }}"
  data-enable-sticky="{{ section.settings.enable_sticky_bar }}"
  data-enable-recent="{{ section.settings.enable_recently_viewed }}"
>
  <div class="container ps-pdp__main">
    <div class="ps-pdp__grid">
      {%- comment -%} LEFT — Gallery {%- endcomment -%}
      <div class="ps-pdp__gallery" data-ps-gallery>
        <div class="ps-pdp__thumbs" data-ps-thumbs>
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              <button
                type="button"
                class="ps-pdp__thumb{% if forloop.first %} is-active{% endif %}"
                data-ps-thumb
                data-media-index="{{ forloop.index0 }}"
                data-media-type="{{ media.media_type }}"
                aria-label="View image {{ forloop.index }}"
              >
                {%- if media.media_type == 'video' -%}
                  {{ media.preview_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: product.title }}
                  <span class="ps-pdp__thumb-play" aria-hidden="true">▶</span>
                {%- else -%}
                  {{ media | image_url: width: 120 | image_tag: loading: 'lazy', alt: media.alt | default: product.title }}
                {%- endif -%}
              </button>
            {%- endfor -%}
          {%- elsif product.featured_image -%}
            <button type="button" class="ps-pdp__thumb is-active" data-ps-thumb data-media-index="0" data-media-type="image">
              {{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: product.title }}
            </button>
          {%- endif -%}
        </div>

        <div class="ps-pdp__main-media" data-ps-main-media>
          <div class="ps-pdp__media-track" data-ps-media-track>
            {%- if product.media.size > 0 -%}
              {%- for media in product.media -%}
                <div class="ps-pdp__media-slide{% if forloop.first %} is-active{% endif %}" data-ps-media-slide data-index="{{ forloop.index0 }}">
                  {%- if media.media_type == 'video' -%}
                    <div class="ps-pdp__video-wrap">
                      {{ media | video_tag: class: 'ps-pdp__video', controls: true, autoplay: false, loop: true, muted: true, image_size: '800x' }}
                    </div>
                  {%- else -%}
                    <div class="ps-pdp__zoom-wrap" data-ps-zoom>
                      {{ media | image_url: width: 1200 | image_tag: class: 'ps-pdp__main-img', loading: 'eager', widths: '600, 800, 1000, 1200', sizes: '(max-width: 767px) 100vw, 50vw', alt: media.alt | default: product.title }}
                    </div>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            {%- elsif product.featured_image -%}
              <div class="ps-pdp__media-slide is-active" data-ps-media-slide data-index="0">
                <div class="ps-pdp__zoom-wrap" data-ps-zoom>
                  {{ product.featured_image | image_url: width: 1200 | image_tag: class: 'ps-pdp__main-img', loading: 'eager', alt: product.title }}
                </div>
              </div>
            {%- else -%}
              <div class="ps-pdp__media-slide is-active" data-ps-media-slide>
                <div class="ps-pdp__placeholder"></div>
              </div>
            {%- endif -%}
          </div>
          <span class="ps-pdp__counter" data-ps-counter>1 / {{ media_count }}</span>
        </div>
      </div>

      {%- comment -%} RIGHT — Product info {%- endcomment -%}
      <div class="ps-pdp__info">
        <nav class="ps-pdp__breadcrumb" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">Home</a>
          <span aria-hidden="true">›</span>
          <a href="{{ routes.collections_url }}/men">Men</a>
          {%- if bc_collection -%}
            <span aria-hidden="true">›</span>
            <a href="{{ bc_collection.url }}">{{ bc_collection.title }}</a>
          {%- endif -%}
          <span aria-hidden="true">›</span>
          <span aria-current="page">{{ product.title }}</span>
        </nav>

        {%- if product.vendor != blank -%}
          <p class="ps-pdp__vendor">{{ product.vendor }}</p>
        {%- endif -%}

        <h1 class="ps-pdp__title">{{ product.title }}</h1>

        <div class="ps-pdp__rating-row">
          <div class="ps-pdp__stars" aria-label="4.5 out of 5 stars">
            {%- for i in (1..4) -%}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="#f59e0b" aria-hidden="true"><path d="M12 2l2.9 6.9L22 10l-5.2 4.5L18.2 22 12 18.5 5.8 22l1.4-7.5L2 10l7.1-1.1L12 2z"/></svg>
            {%- endfor -%}
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><defs><linearGradient id="half-{{ section.id }}"><stop offset="50%" stop-color="#f59e0b"/><stop offset="50%" stop-color="#e5e7eb"/></linearGradient></defs><path d="M12 2l2.9 6.9L22 10l-5.2 4.5L18.2 22 12 18.5 5.8 22l1.4-7.5L2 10l7.1-1.1L12 2z" fill="url(#half-{{ section.id }})"/></svg>
          </div>
          <span class="ps-pdp__rating-text">4.5 — 24 reviews</span>
        </div>

        <div class="ps-pdp__price-block" data-ps-price-block>
          {%- if on_sale -%}
            <span class="ps-pdp__price ps-pdp__price--sale" data-ps-price>{{ current_variant.price | money }}</span>
            <s class="ps-pdp__compare" data-ps-compare>{{ current_variant.compare_at_price | money }}</s>
            <span class="ps-pdp__save-badge" data-ps-save-badge>SAVE {{ save_percent }}%</span>
          {%- else -%}
            <span class="ps-pdp__price" data-ps-price>{{ current_variant.price | money }}</span>
            <s class="ps-pdp__compare" data-ps-compare hidden></s>
            <span class="ps-pdp__save-badge" data-ps-save-badge hidden></span>
          {%- endif -%}
        </div>

        {%- if short_desc != blank -%}
          <p class="ps-pdp__short-desc">{{ short_desc }}</p>
        {%- endif -%}

        {% form 'product', product, id: 'ProductForm', class: 'ps-pdp__form', data-ps-product-form: '' %}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-ps-variant-input>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- assign opt_down = option.name | downcase -%}
              <div class="ps-pdp__option" data-option-index="{{ forloop.index0 }}" data-option-name="{{ option.name }}">
                <label class="ps-pdp__option-label">{{ option.name }}</label>
                {%- if opt_down == 'color' or opt_down == 'colour' -%}
                  <div class="ps-pdp__swatches" data-ps-option-swatches>
                    {%- for value in option.values -%}
                      <button
                        type="button"
                        class="ps-pdp__swatch{% if option.selected_value == value %} is-selected{% endif %}"
                        data-option-value="{{ value | escape }}"
                        data-color-swatch
                        title="{{ value }}"
                        style="--swatch-color: {{ value | handle | replace: 'navy-blue', '#1e3a5f' | replace: 'black', '#000' | replace: 'white', '#fff' }}"
                      >
                        <span class="ps-pdp__swatch-inner" data-swatch-name="{{ value | handle }}"></span>
                      </button>
                    {%- endfor -%}
                  </div>
                {%- else -%}
                  <div class="ps-pdp__size-btns" data-ps-option-buttons>
                    {%- for value in option.values -%}
                      <button
                        type="button"
                        class="ps-pdp__size-btn{% if option.selected_value == value %} is-selected{% endif %}"
                        data-option-value="{{ value | escape }}"
                      >
                        {{ value }}
                        <span class="ps-pdp__size-unavail" aria-hidden="true">✕</span>
                      </button>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <p class="ps-pdp__selected-options" data-ps-selected-options></p>

          <div class="ps-pdp__stock" data-ps-stock>
            {%- if current_variant.available -%}
              {%- if current_variant.inventory_management and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= low_stock_threshold -%}
                <span class="ps-pdp__stock-dot ps-pdp__stock-dot--yellow"></span>
                <span data-ps-stock-text>Only {{ current_variant.inventory_quantity }} left!</span>
              {%- else -%}
                <span class="ps-pdp__stock-dot ps-pdp__stock-dot--green"></span>
                <span data-ps-stock-text>In Stock — Ships within 24 hours</span>
              {%- endif -%}
            {%- else -%}
              <span class="ps-pdp__stock-dot ps-pdp__stock-dot--red"></span>
              <span data-ps-stock-text>Out of Stock</span>
            {%- endif -%}
          </div>

          <div class="ps-pdp__qty-row">
            <label class="ps-pdp__option-label" for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
            <div class="ps-pdp__qty">
              <button type="button" class="ps-pdp__qty-btn" data-ps-qty-minus aria-label="Decrease quantity">−</button>
              <input type="number" id="Quantity-{{ section.id }}" name="quantity" value="1" min="1" class="ps-pdp__qty-input" data-ps-qty-input>
              <button type="button" class="ps-pdp__qty-btn" data-ps-qty-plus aria-label="Increase quantity">+</button>
            </div>
          </div>

          <div class="ps-pdp__actions" data-ps-main-atc-wrap>
            <button
              type="button"
              class="btn btn-primary ps-pdp__atc"
              data-ps-add-to-cart
              {% unless current_variant.available %}disabled{% endunless %}
            >
              <span class="ps-pdp__atc-text" data-ps-atc-text>{% if current_variant.available %}{{ 'products.add_to_cart' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</span>
              <span class="ps-pdp__atc-spinner" data-ps-atc-spinner hidden><svg width="20" height="20" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" fill="none" stroke-dasharray="31.4"><animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="0.8s" repeatCount="indefinite"/></circle></svg></span>
              <span class="ps-pdp__atc-success" data-ps-atc-success hidden>✓ Added to Cart</span>
            </button>
            <button type="button" class="btn btn-secondary ps-pdp__buy-now" data-ps-buy-now {% unless current_variant.available %}disabled{% endunless %}>
              {{ 'products.buy_now' | t }}
            </button>
            <button type="button" class="ps-pdp__wishlist-btn" data-ps-wishlist-btn data-product-id="{{ product.id }}">
              <span data-ps-wishlist-icon>♡</span> {{ 'products.add_to_wishlist' | t }}
            </button>
          </div>
        {% endform %}

        <div class="ps-pdp__mini-trust">
          <span>🚚 Free Shipping</span>
          <span>↩️ Easy Returns</span>
          <span>🔒 Secure Payment</span>
        </div>

        <div class="ps-pdp__share">
          <span class="ps-pdp__share-label">{{ 'products.share' | t }}:</span>
          <a href="https://wa.me/?text={{ product.title | url_encode }}%20{{ shop.url | append: product.url | url_encode }}" class="ps-pdp__share-btn" target="_blank" rel="noopener" aria-label="Share on WhatsApp">WhatsApp</a>
          <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url | append: product.url | url_encode }}" class="ps-pdp__share-btn" target="_blank" rel="noopener" aria-label="Share on Facebook">Facebook</a>
          <button type="button" class="ps-pdp__share-btn" data-ps-copy-link>{{ 'products.copy_link' | t }}</button>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} Tabs {%- endcomment -%}
  <div class="container ps-pdp__tabs-wrap">
    <div class="ps-pdp__tabs" data-ps-tabs>
      <div class="ps-pdp__tab-list" role="tablist">
        <button type="button" class="ps-pdp__tab is-active" role="tab" aria-selected="true" data-ps-tab="description">{{ 'products.tab_description' | t }}</button>
        <button type="button" class="ps-pdp__tab" role="tab" aria-selected="false" data-ps-tab="size-guide">{{ 'products.tab_size_guide' | t }}</button>
        <button type="button" class="ps-pdp__tab" role="tab" aria-selected="false" data-ps-tab="shipping">{{ 'products.tab_shipping' | t }}</button>
        <button type="button" class="ps-pdp__tab" role="tab" aria-selected="false" data-ps-tab="reviews">{{ 'products.tab_reviews' | t }}</button>
      </div>

      <div class="ps-pdp__tab-panel is-active" data-ps-tab-panel="description" role="tabpanel">
        <div class="rte">{{ product.description }}</div>
      </div>

      <div class="ps-pdp__tab-panel" data-ps-tab-panel="size-guide" role="tabpanel" hidden>
        <table class="ps-pdp__size-table">
          <thead>
            <tr><th>Size</th><th>Chest (in)</th><th>Waist (in)</th><th>Length (in)</th></tr>
          </thead>
          <tbody>
            <tr><td>S</td><td>36</td><td>30</td><td>28</td></tr>
            <tr><td>M</td><td>38</td><td>32</td><td>29</td></tr>
            <tr><td>L</td><td>40</td><td>34</td><td>30</td></tr>
            <tr><td>XL</td><td>42</td><td>36</td><td>31</td></tr>
            <tr><td>XXL</td><td>44</td><td>38</td><td>32</td></tr>
          </tbody>
        </table>
      </div>

      <div class="ps-pdp__tab-panel" data-ps-tab-panel="shipping" role="tabpanel" hidden>
        <div class="ps-pdp__shipping-text">
          <p>Free shipping on orders above PKR 2,500.</p>
          <p>Standard delivery: 3-5 business days.</p>
          <p>Express delivery: 1-2 business days (PKR 200 extra).</p>
          <p>Easy 7-day returns on unused items.</p>
        </div>
      </div>

      <div class="ps-pdp__tab-panel" data-ps-tab-panel="reviews" role="tabpanel" hidden>
        <div class="ps-pdp__reviews-summary">
          <div class="ps-pdp__reviews-avg">
            <span class="ps-pdp__reviews-score">4.5</span>
            <div class="ps-pdp__stars">
              {%- for i in (1..4) -%}<svg width="20" height="20" viewBox="0 0 24 24" fill="#f59e0b"><path d="M12 2l2.9 6.9L22 10l-5.2 4.5L18.2 22 12 18.5 5.8 22l1.4-7.5L2 10l7.1-1.1L12 2z"/></svg>{%- endfor -%}
              <svg width="20" height="20" viewBox="0 0 24 24"><defs><linearGradient id="half-rev-{{ section.id }}"><stop offset="50%" stop-color="#f59e0b"/><stop offset="50%" stop-color="#e5e7eb"/></linearGradient></defs><path d="M12 2l2.9 6.9L22 10l-5.2 4.5L18.2 22 12 18.5 5.8 22l1.4-7.5L2 10l7.1-1.1L12 2z" fill="url(#half-rev-{{ section.id }})"/></svg>
            </div>
            <span>24 reviews</span>
          </div>
          <div class="ps-pdp__reviews-bars">
            <div class="ps-pdp__bar-row"><span>5★</span><div class="ps-pdp__bar"><div style="width:60%"></div></div><span>60%</span></div>
            <div class="ps-pdp__bar-row"><span>4★</span><div class="ps-pdp__bar"><div style="width:25%"></div></div><span>25%</span></div>
            <div class="ps-pdp__bar-row"><span>3★</span><div class="ps-pdp__bar"><div style="width:10%"></div></div><span>10%</span></div>
            <div class="ps-pdp__bar-row"><span>2★</span><div class="ps-pdp__bar"><div style="width:3%"></div></div><span>3%</span></div>
            <div class="ps-pdp__bar-row"><span>1★</span><div class="ps-pdp__bar"><div style="width:2%"></div></div><span>2%</span></div>
          </div>
        </div>
        <div class="ps-pdp__review-list">
          <article class="ps-pdp__review">
            <div class="ps-pdp__review-meta"><strong>Ahmed K.</strong> · Jan 12, 2026 · ★★★★★</div>
            <p>Excellent quality and perfect fit. The fabric feels premium and washes well.</p>
          </article>
          <article class="ps-pdp__review">
            <div class="ps-pdp__review-meta"><strong>Usman T.</strong> · Dec 28, 2025 · ★★★★☆</div>
            <p>Great shirt, delivery was fast. Slightly larger than expected but still love it.</p>
          </article>
          <article class="ps-pdp__review">
            <div class="ps-pdp__review-meta"><strong>Bilal M.</strong> · Dec 15, 2025 · ★★★★★</div>
            <p>Best purchase this season. Will definitely order more from PakStyle.</p>
          </article>
        </div>
        <button type="button" class="btn btn-secondary ps-pdp__write-review">{{ 'products.write_review' | t }}</button>
      </div>
    </div>
  </div>

  {%- if section.settings.enable_related_products and bc_collection -%}
    <div class="container ps-pdp__related">
      <h2 class="ps-pdp__section-title">{{ 'products.related_title' | t }}</h2>
      <div class="ps-pdp__cards-grid ps-pdp__cards-grid--{{ related_limit }}">
        {%- assign related_count = 0 -%}
        {%- for related in bc_collection.products -%}
          {%- if related.id != product.id -%}
            {% render 'product-card', card_product: related %}
            {%- assign related_count = related_count | plus: 1 -%}
            {%- if related_count >= related_limit -%}
              {%- break -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.enable_recently_viewed -%}
    <div class="container ps-pdp__recent" data-ps-recent-section hidden>
      <h2 class="ps-pdp__section-title">{{ 'products.recently_viewed' | t }}</h2>
      <div class="ps-pdp__cards-grid ps-pdp__cards-grid--4" data-ps-recent-grid></div>
    </div>
  {%- endif -%}

  {%- if section.settings.enable_sticky_bar -%}
    <div class="ps-pdp__sticky" data-ps-sticky-bar hidden>
      <div class="ps-pdp__sticky-inner">
        <div class="ps-pdp__sticky-info">
          <p class="ps-pdp__sticky-title">{{ product.title | truncate: 30 }}</p>
          <p class="ps-pdp__sticky-price" data-ps-sticky-price>{{ current_variant.price | money }}</p>
        </div>
        <button type="button" class="btn btn-primary ps-pdp__sticky-atc" data-ps-sticky-atc {% unless current_variant.available %}disabled{% endunless %}>
          {{ 'products.add_to_cart' | t }}
        </button>
      </div>
    </div>
  {%- endif -%}

  <div class="ps-quick-add-modal" data-ps-quick-add-modal hidden>
    <div class="ps-quick-add-modal__backdrop" data-ps-quick-add-close></div>
    <div class="ps-quick-add-modal__panel" role="dialog" aria-modal="true">
      <div class="ps-quick-add-modal__header">
        <h3 class="ps-quick-add-modal__title" data-ps-quick-add-title></h3>
        <button type="button" class="ps-quick-add-modal__close" data-ps-quick-add-close aria-label="{{ 'general.close' | t }}">&times;</button>
      </div>
      <div class="ps-quick-add-modal__options" data-ps-quick-add-options></div>
      <button type="button" class="btn btn-primary ps-quick-add-modal__submit" data-ps-quick-add-submit disabled>{{ 'products.add_to_cart' | t }}</button>
    </div>
  </div>

  <script type="application/json" data-ps-product-json>{{ product | json }}</script>
</section>

<style>
  #shopify-section-{{ section.id }} .ps-pdp { padding-bottom: 48px; }
  #shopify-section-{{ section.id }} .ps-pdp__main { padding: 24px 16px 48px; }
  #shopify-section-{{ section.id }} .ps-pdp__grid { display: grid; grid-template-columns: 1fr; gap: 32px; }
  #shopify-section-{{ section.id }} .ps-pdp__gallery { display: flex; flex-direction: column-reverse; gap: 12px; }
  #shopify-section-{{ section.id }} .ps-pdp__thumbs { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; }
  #shopify-section-{{ section.id }} .ps-pdp__thumbs::-webkit-scrollbar { display: none; }
  #shopify-section-{{ section.id }} .ps-pdp__thumb { flex: 0 0 72px; width: 72px; height: 72px; border: 2px solid transparent; border-radius: 8px; overflow: hidden; position: relative; opacity: 0.6; transition: opacity 0.2s, border-color 0.2s; }
  #shopify-section-{{ section.id }} .ps-pdp__thumb.is-active { opacity: 1; border-color: var(--color-accent, #F97316); }
  #shopify-section-{{ section.id }} .ps-pdp__thumb img { width: 100%; height: 100%; object-fit: cover; }
  #shopify-section-{{ section.id }} .ps-pdp__thumb-play { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.4); color: #fff; font-size: 0.75rem; }
  #shopify-section-{{ section.id }} .ps-pdp__main-media { position: relative; border-radius: 12px; overflow: hidden; background: #f3f4f6; aspect-ratio: 3/4; }
  #shopify-section-{{ section.id }} .ps-pdp__media-track { height: 100%; position: relative; }
  #shopify-section-{{ section.id }} .ps-pdp__media-slide { display: none; height: 100%; }
  #shopify-section-{{ section.id }} .ps-pdp__media-slide.is-active { display: block; }
  #shopify-section-{{ section.id }} .ps-pdp__zoom-wrap { height: 100%; overflow: hidden; }
  #shopify-section-{{ section.id }} .ps-pdp__main-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  #shopify-section-{{ section.id }} .ps-pdp__zoom-wrap:hover .ps-pdp__main-img { transform: scale(1.08); }
  #shopify-section-{{ section.id }} .ps-pdp__video-wrap, #shopify-section-{{ section.id }} .ps-pdp__video { width: 100%; height: 100%; object-fit: cover; }
  #shopify-section-{{ section.id }} .ps-pdp__placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, #e2e8f0, #cbd5e1); }
  #shopify-section-{{ section.id }} .ps-pdp__counter { position: absolute; bottom: 12px; right: 12px; padding: 4px 10px; background: rgba(15,23,42,0.7); color: #fff; font-size: 0.75rem; font-weight: 600; border-radius: 999px; }
  #shopify-section-{{ section.id }} .ps-pdp__breadcrumb { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-bottom: 12px; font-size: 0.8125rem; color: var(--color-text-light, #6B7280); }
  #shopify-section-{{ section.id }} .ps-pdp__breadcrumb a { color: var(--color-text-light, #6B7280); }
  #shopify-section-{{ section.id }} .ps-pdp__breadcrumb a:hover { color: var(--color-accent, #F97316); }
