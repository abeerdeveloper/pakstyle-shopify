{%- comment -%}
  PakStyle — SEO JSON-LD Structured Data
  Outputs structured data for Google Search rich snippets.
{%- endcomment -%}

{%- liquid
  assign brand_name = 'PakStyle'
  assign instagram_url = 'https://www.instagram.com/pakstyle'
  assign facebook_url = 'https://www.facebook.com/pakstyle'
  assign country_code = 'PK'
-%}

{%- comment -%} 1. Global / Homepage: Store & Website Schema {%- endcomment -%}
{%- if template.name == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Store",
      "name": {{ brand_name | json }},
      "url": {{ shop.url | json }},
      "description": {{ shop.description | default: 'Bold casual clothing for young men in Pakistan.' | json }},
      "image": {%- if settings.og_image -%}{{ settings.og_image | image_url: width: 600 | prepend: 'https:' | json }}{%- elsif shop.brand.logo -%}{{ shop.brand.logo | image_url: width: 600 | prepend: 'https:' | json }}{%- else -%}{{ shop.url | append: '/cdn/shop/files/logo.png' | json }}{%- endif -%},
      "address": {
        "@type": "PostalAddress",
        "addressCountry": {{ country_code | json }}
      },
      "sameAs": [
        {{ instagram_url | json }},
        {{ facebook_url | json }}
      ]
    }
  </script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ brand_name | json }},
      "url": {{ shop.url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ shop.url | append: '/search?q={search_term_string}' | json }},
        "query-input": "required name=search_term_string"
      }
    }
  </script>
{%- endif -%}

{%- comment -%} 2. Product Page Schema {%- endcomment -%}
{%- if template.name == 'product' -%}
  {%- assign current_variant = product.selected_or_first_available_variant -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": {{ product.title | json }},
      "image": [
        {%- for image in product.images -%}
          {{ image.src | image_url: width: 1000 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ],
      "description": {{ product.description | strip_html | strip_newlines | json }},
      "sku": {{ current_variant.sku | default: product.id | json }},
      "mpn": {{ current_variant.barcode | default: current_variant.sku | default: product.id | json }},
      "brand": {
        "@type": "Brand",
        "name": {{ product.vendor | default: brand_name | json }}
      },
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "lowPrice": {{ product.price_min | divided_by: 100.0 | json }},
        "highPrice": {{ product.price_max | divided_by: 100.0 | json }},
        "offerCount": {{ product.variants.size | json }},
        "price": {{ product.price | divided_by: 100.0 | json }},
        "url": {{ shop.url | append: product.url | json }},
        "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
        "itemCondition": "https://schema.org/NewCondition"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.5",
        "reviewCount": "24"
      }
    }
  </script>
{%- endif -%}

{%- comment -%} 3. Collection Page Schema {%- endcomment -%}
{%- if template.name == 'collection' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": {{ collection.title | json }},
      "url": {{ shop.url | append: collection.url | json }},
      "description": {{ collection.description | default: shop.description | strip_html | strip_newlines | json }},
      "numberOfItems": {{ collection.products_count | json }},
      "itemListElement": [
        {%- for product in collection.products limit: 24 -%}
          {
            "@type": "ListItem",
            "position": {{ forloop.index | json }},
            "url": {{ shop.url | append: product.url | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{%- comment -%} 4. Breadcrumb Schema {%- endcomment -%}
{%- if template.name == 'collection' or template.name == 'product' or template.name == 'page' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ shop.url | json }}
        }
        {%- if template.name == 'collection' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": {{ shop.url | append: collection.url | json }}
          }
        {%- elsif template.name == 'product' -%}
          {%- assign bc_collection = collection | default: product.collections.first -%}
          {%- if bc_collection -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ bc_collection.title | json }},
              "item": {{ shop.url | append: bc_collection.url | json }}
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": {{ product.title | json }},
              "item": {{ shop.url | append: product.url | json }}
            }
          {%- else -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ product.title | json }},
              "item": {{ shop.url | append: product.url | json }}
            }
          {%- endif -%}
        {%- elsif template.name == 'page' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ page.title | json }},
            "item": {{ shop.url | append: page.url | json }}
          }
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}
